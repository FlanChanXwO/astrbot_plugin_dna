{% from "cards/macros/layout.html.j2" import card_shell %}
{% call card_shell(width, 646, class_name="mh-simple") %}
<style>
  @font-face { font-family: "DNAUnicode"; src: url("{{ font }}") format("woff2"); }
  .mh-simple { color: #323232; background: #fff; font-family: "DNAUnicode", sans-serif; }
  .mh-simple .dna-card__content { position: relative; height: 646px; background: #fff; }
  .mh-simple__entry { position: absolute; top: 0; width: 320px; height: 576px; min-width: 0; text-align: center; }
  {% for entry in entries %}.mh-simple__entry:nth-of-type({{ loop.index }}) { left: {{ 20 + (loop.index0 * 340) }}px; }{% endfor %}
  .mh-simple__entry:not(:first-of-type) { border-left: 2px solid #f0f0f0; }
  .mh-simple__icon { position: absolute; top: 50px; left: 32px; width: 256px; height: 256px; object-fit: fill; }
  .mh-simple__type { position: absolute; top: 326px; left: 0; width: 320px; height: 50px; margin: 0; color: #8b4513; font-size: 40px; line-height: 50px; }
  .mh-simple__instances { position: absolute; top: 376px; left: 30px; width: 260px; height: 200px; margin: 0; padding: 20px 0 0; border-top: 2px solid #f0f0f0; list-style: none; }
  .mh-simple__instances li { height: 50px; margin: 0; color: #1e283c; font-size: 36px; line-height: 50px; overflow-wrap: anywhere; }
  .mh-simple__instances li.subscribed { color: #4caf50; font-weight: 700; }
  .mh-simple__footer { position: absolute; right: 0; bottom: 10px; left: 0; height: 60px; margin: 0; padding: 10px; background: #f8f8f8; font-size: 30px; line-height: 40px; text-align: center; }
</style>
{% for entry in entries %}<article class="mh-simple__entry">{% if entry.icon %}<img class="mh-simple__icon" src="{{ entry.icon }}" alt="" />{% endif %}<h1 class="mh-simple__type">{{ entry.type_name }}</h1><ul class="mh-simple__instances">{% for instance in entry.instances %}<li{% if instance.subscribed %} class="subscribed"{% endif %}>{{ instance.name }}</li>{% endfor %}</ul></article>{% endfor %}
<p class="mh-simple__footer">当前轮换：{{ refresh_text }}</p>
{% endcall %}
