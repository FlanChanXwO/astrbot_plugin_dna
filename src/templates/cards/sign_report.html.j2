{% from "cards/macros/layout.html.j2" import card_shell %}
{% call card_shell(width, 250, class_name="sign-report") %}
<style>
  @font-face { font-family: "DNAUnicode"; src: url("{{ font }}") format("woff2"); }
  .sign-report { position: relative; min-height: 250px; color: #333; background: linear-gradient(180deg, {{ theme_color }}, #fff); font-family: "DNAUnicode", sans-serif; }
  .sign-report::before { position: absolute; top: 10px; left: 10px; width: 576px; height: 226px; border: 2px solid #c8c8c8; content: ""; }
  .sign-report__line { position: absolute; left: 40px; margin: 0; font-size: 24px; font-weight: 400; line-height: 30px; }
</style>
{% for line in lines %}<p class="sign-report__line" style="top: {% if loop.index0 == 0 %}40{% else %}{{ 100 + (loop.index0 - 1) * 45 }}{% endif %}px">{{ line }}</p>{% endfor %}
{% endcall %}
