{% from "cards/macros/layout.html.j2" import card_shell %}
{% from "cards/macros/components.html.j2" import legacy_profile_header %}
{% call card_shell(width, background=background, class_name="role-detail") %}
<style>
  @font-face { font-family: "DNAFont"; src: url("{{ font }}") format("woff2"); }
  .role-detail { position: relative; width: 1000px; color: #fff; background: transparent; font-family: "DNAFont", sans-serif; overflow: hidden; }
  .role-detail__hero { position: relative; width: 1000px; height: 850px; overflow: hidden; }
  .role-detail__hero-image { position: absolute; inset: 0; width: 1000px; height: 850px; object-fit: fill; }
  .role-detail__identity { position: absolute; top: 80px; left: 550px; width: 400px; height: 703px; }
  .role-detail__identity .point { position: absolute; top: 10px; left: 10px; width: 30px; height: 30px; }
  .role-detail__identity h1 { position: absolute; top: 8px; left: 50px; margin: 0; font-size: 30px; font-weight: 400; line-height: 38px; }
  .role-detail__badges { position: absolute; top: 60px; left: 10px; display: flex; gap: 8px; align-items: center; height: 35px; }
  .role-detail__badges img { width: 34px; height: 35px; object-fit: contain; }
  .role-detail__badge { display: inline-flex; align-items: center; height: 35px; padding: 0 10px; border-radius: 7px; background: #b22222; font-size: 26px; line-height: 35px; }
  .role-detail__grade-badge { display: grid; place-items: center; width: 34px; height: 35px; padding: 0; }.role-detail__grade-badge img { width: 34px; height: 25px; object-fit: contain; }
  .role-detail__attributes { position: absolute; top: 120px; left: 0; width: 400px; height: 583px; }
  .role-detail__attribute { display: grid; grid-template-columns: 53px 1fr auto; align-items: center; width: 400px; height: 53px; padding: 0 30px 0 0; background-position: center; background-repeat: no-repeat; background-size: 400px 53px; }
  .role-detail__attribute img { width: 53px; height: 53px; object-fit: contain; }
  .role-detail__attribute span, .role-detail__attribute strong { font-size: 26px; font-weight: 400; line-height: 53px; }
  .role-detail__grades { position: absolute; top: 750px; left: 0; width: 500px; height: 65px; }
  .role-detail__grade { position: absolute; top: 0; width: 64px; height: 64px; background-position: center; background-repeat: no-repeat; background-size: 64px 64px; }
  .role-detail__grade img { position: absolute; top: 19px; left: 17px; width: 31px; height: 23px; object-fit: fill; }
  .role-detail__divider { display: block; width: 1046px; height: 53px; margin-left: -23px; object-fit: fill; }
  .role-detail__skills { position: relative; width: 1000px; height: 160px; }
  .role-detail__skill { position: absolute; top: 0; width: 300px; height: 160px; background: center/300px 160px no-repeat; }
  .role-detail__skill:nth-child(1) { left: 50px; }.role-detail__skill:nth-child(2) { left: 350px; }.role-detail__skill:nth-child(3) { left: 650px; }
  .role-detail__skill img { position: absolute; top: 30px; left: 20px; width: 100px; height: 100px; object-fit: contain; }
  .role-detail__skill h3 { position: absolute; top: 38px; left: 120px; width: 170px; margin: 0; color: #daa520; font-size: 24px; font-weight: 400; line-height: 30px; overflow-wrap: anywhere; }
  .role-detail__skill p { position: absolute; top: 80px; left: 120px; width: 80px; height: 30px; margin: 0; border-radius: 10px; background: #fa8072; font-size: 26px; line-height: 30px; text-align: center; }
  .role-detail__weapon-section { position: relative; width: 1000px; height: 750px; }
  .role-detail__weapon-section.modes-4 { height: 490px; }
  .role-detail__weapon-title { position: absolute; top: 0; left: 50px; margin: 0; color: #eee8aa; font-size: 24px; font-weight: 400; line-height: 52px; }
  .role-detail__weapon-line { position: absolute; top: 25px; right: 50px; border-top: 1px solid rgba(255,255,255,.27); }
  .role-detail__weapon-info { position: absolute; top: 570px; left: 0; width: 1000px; height: 180px; }
  .role-detail__weapon-section.modes-4 .role-detail__weapon-info { top: 310px; }
  .role-detail__weapon-card { position: absolute; top: 0; left: 70px; width: 217px; height: 122px; overflow: hidden; background-position: center; background-repeat: no-repeat; background-size: 217px 122px; }
  .role-detail__weapon-icon { position: absolute; top: -8px; left: -8px; width: 144px; height: 144px; object-fit: fill; }
  .role-detail__weapon-name { position: absolute; top: 122px; left: 70px; margin: 0; font-size: 26px; font-weight: 400; line-height: 40px; }
  .role-detail__weapon-level { position: absolute; top: 80px; left: 120px; width: 64px; height: 28px; border-radius: 6px; background: #b22222; font-size: 21px; line-height: 28px; text-align: center; }
  .role-detail__weapon-attrs { position: absolute; top: 0; left: 290px; width: 641px; height: 160px; background-position: center; background-repeat: no-repeat; background-size: 641px 160px; }
  .role-detail__weapon-attr { position: absolute; display: grid; grid-template-columns: 53px 1fr auto; align-items: center; width: 320px; height: 53px; }
  .role-detail__weapon-attr:nth-child(odd) { left: 0; }.role-detail__weapon-attr:nth-child(even) { left: 320px; }
  .role-detail__weapon-attr:nth-child(-n+2) { top: 0; }.role-detail__weapon-attr:nth-child(n+3):nth-child(-n+4) { top: 53px; }.role-detail__weapon-attr:nth-child(n+5) { top: 106px; }
  .role-detail__weapon-attr img { width: 53px; height: 53px; object-fit: contain; }.role-detail__weapon-attr span, .role-detail__weapon-attr strong { font-size: 26px; font-weight: 400; }
  .role-detail__weapon-modes { position: absolute; inset: 0; width: 1000px; height: 552px; }
  .role-detail__mode { position: absolute; width: 250px; height: 242px; overflow: hidden; }.role-detail__mode-bg { position: absolute; inset: 0; width: 250px; height: 242px; }.role-detail__mode-content { position: absolute; inset: 0; }.role-detail__mode-icon { position: absolute; top: 15px; left: 35px; width: 180px; height: 180px; object-fit: fill; }.role-detail__mode h4 { position: absolute; top: 161px; left: 115px; margin: 0; color: #fff; font-size: 26px; font-weight: 400; line-height: 38px; white-space: nowrap; transform: translateX(-50%); }.role-detail__mode-level { position: absolute; top: 30px; left: 54px; width: 52px; height: 30px; border-radius: 10px; background: #ff4500; font-size: 26px; line-height: 30px; text-align: center; }
  .role-detail__mode.mode-right h4 { left: 140px; }.role-detail__mode.mode-right .role-detail__mode-level { left: 134px; }
  .role-detail__weapon-modes .role-detail__mode:nth-child(1) { left: 30px; top: 52px; }.role-detail__weapon-modes .role-detail__mode:nth-child(2) { left: 210px; top: 52px; }.role-detail__weapon-modes .role-detail__mode:nth-child(3) { left: 30px; top: 302px; }.role-detail__weapon-modes .role-detail__mode:nth-child(4) { left: 210px; top: 302px; }.role-detail__weapon-modes .role-detail__mode:nth-child(5) { left: 530px; top: 52px; }.role-detail__weapon-modes .role-detail__mode:nth-child(6) { left: 710px; top: 52px; }.role-detail__weapon-modes .role-detail__mode:nth-child(7) { left: 530px; top: 302px; }.role-detail__weapon-modes .role-detail__mode:nth-child(8) { left: 710px; top: 302px; }
  .role-detail__weapon-section.modes-4 .role-detail__weapon-modes .role-detail__mode:nth-child(1) { left: 40px; top: 52px; }.role-detail__weapon-section.modes-4 .role-detail__weapon-modes .role-detail__mode:nth-child(2) { left: 260px; top: 52px; }.role-detail__weapon-section.modes-4 .role-detail__weapon-modes .role-detail__mode:nth-child(3) { left: 480px; top: 52px; }.role-detail__weapon-section.modes-4 .role-detail__weapon-modes .role-detail__mode:nth-child(4) { left: 700px; top: 52px; }
  .role-detail__mods { position: relative; width: 1000px; height: 500px; }.role-detail__mods .role-detail__mode:nth-child(1) { left: 30px; top: 0; }.role-detail__mods .role-detail__mode:nth-child(2) { left: 210px; top: 0; }.role-detail__mods .role-detail__mode:nth-child(3) { left: 30px; top: 250px; }.role-detail__mods .role-detail__mode:nth-child(4) { left: 210px; top: 250px; }.role-detail__mods .role-detail__mode:nth-child(5) { left: 530px; top: 0; }.role-detail__mods .role-detail__mode:nth-child(6) { left: 710px; top: 0; }.role-detail__mods .role-detail__mode:nth-child(7) { left: 530px; top: 250px; }.role-detail__mods .role-detail__mode:nth-child(8) { left: 710px; top: 250px; }.role-detail__mods .role-detail__mode:nth-child(9) { left: 415px; top: 100px; width: 162px; height: 198px; }.role-detail__mods .role-detail__mode:nth-child(9) .role-detail__mode-bg { width: 162px; height: 198px; }.role-detail__mods .role-detail__mode:nth-child(9) .role-detail__mode-icon { top: 5px; left: 5px; width: 150px; height: 150px; }.role-detail__mods .role-detail__mode:nth-child(9) h4 { top: 151px; left: 80px; }.role-detail__mods .role-detail__mode:nth-child(9) .role-detail__mode-level { top: 110px; left: 110px; width: 40px; }
  .role-detail__damage { width: 900px; margin: 20px 50px; padding: 20px; border-radius: 10px; background: rgba(16,16,19,.77); }
  .role-detail__damage.is-error { height: 270px; }
  .role-detail__damage-head { display: flex; justify-content: space-between; align-items: center; height: 64px; padding: 0 16px; background: rgba(55,55,58,.75); }.role-detail__damage-head h2 { margin: 0; padding-left: 10px; border-left: 4px solid #fff7cf; color: #fff7cf; font-size: 30px; font-weight: 400; }.role-detail__damage-head div { font-size: 18px; text-align: right; }.role-detail__lineup { display: flex; gap: 28px; align-items: center; height: 34px; margin-top: 10px; }.role-detail__lineup span { color: #f4d58d; }.role-detail__lineup strong { margin-left: 10px; }.role-detail__status { height: 48px; margin: 20px 0 0; padding: 0 16px; border-left: 4px solid #fff7cf; background: rgba(55,55,58,.75); color: #fff7cf; font-size: 28px; font-weight: 400; line-height: 48px; }.role-detail__error { height: 48px; margin: 6px 0 0; background: rgba(9,9,10,.3); font-size: 24px; line-height: 48px; text-align: center; }
  .role-detail__damage-section { margin-top: 20px; }.role-detail__damage-section h3 { height: 48px; margin: 0; padding: 0 16px; border-left: 4px solid #fff7cf; background: rgba(55,55,58,.75); color: #fff7cf; font-size: 28px; font-weight: 400; line-height: 48px; }.role-detail__damage-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 6px 0 0; }.role-detail__damage-grid div { display: flex; justify-content: space-between; min-height: 48px; padding: 10px 18px; background: rgba(9,9,10,.3); }.role-detail__damage-grid dt { color: #f4d58d; }.role-detail__damage-grid dd { margin: 0; }.role-detail__damage-weapons { margin: 6px 0 0; padding: 0; list-style: none; }.role-detail__damage-weapons li { display: grid; grid-template-columns: 90px 1fr auto; min-height: 48px; padding: 10px 18px; background: rgba(255,255,255,.04); }.role-detail__damage-weapons span { color: #f4d58d; }.role-detail__damage-skill { margin-top: 20px; }.role-detail__damage-skill header { display: flex; justify-content: space-between; min-height: 48px; padding: 10px 16px; border-left: 4px solid #fff7cf; background: rgba(55,55,58,.75); }.role-detail__damage-skill h3 { margin: 0; color: #fff7cf; font-size: 26px; font-weight: 400; }.role-detail__damage-child { margin: 8px 0 0; padding-left: 20px; }.role-detail__damage-child h4 { margin: 0; font-size: 22px; font-weight: 400; }
  .role-detail .dna-legacy-profile { width: 1000px; height: 180px; margin: 0; font-family: "DNAFont", sans-serif; }
  .role-detail .dna-legacy-profile__background { width: 1000px; height: 180px; }
  .role-detail .dna-legacy-profile__avatar { top: 38px; left: 112px; width: 100px; height: 100px; }
  .role-detail .dna-legacy-profile__avatar-frame { top: 15px; left: 88px; width: 146px; height: 146px; }
  .role-detail .dna-legacy-profile h1 { top: 54px; left: 246px; height: 46px; font-size: 38px; line-height: 46px; }
  .role-detail .dna-legacy-profile__uid { top: 108px; left: 246px; width: 254px; height: 31px; padding: 0 8px; overflow: visible; font-size: 23px; line-height: 31px; white-space: nowrap; }
  .role-detail .dna-legacy-profile__level { top: 108px; left: 181px; width: 54px; height: 54px; }.role-detail .dna-legacy-profile__level img { width: 57px; height: 58px; }.role-detail .dna-legacy-profile__level span { width: 54px; height: 51px; font-size: 18px; line-height: 51px; }
  .role-detail .dna-legacy-profile dl { top: 69px; left: 523px; width: 378px; height: 69px; background-size: 378px 69px; }.role-detail .dna-legacy-profile dl div { width: 92px; height: 69px; transform: translateX(-46px); }.role-detail .dna-legacy-profile dl div:nth-child(1) { left: 115px !important; }.role-detail .dna-legacy-profile dl div:nth-child(2) { left: 269px !important; }.role-detail .dna-legacy-profile dt { height: 35px; font-size: 31px; line-height: 35px; }.role-detail .dna-legacy-profile dd { height: 26px; font-size: 15px; line-height: 26px; }
  .role-detail__footer { position: relative; width: 1000px; height: 100px; }.role-detail__footer img { position: absolute; right: 200px; bottom: 20px; width: 600px; height: 23px; object-fit: fill; }
</style>
<section class="role-detail__hero"><img class="role-detail__hero-image" src="{{ hero.image }}" alt="" /><div class="role-detail__identity"><img class="point" src="{{ point }}" alt="" /><h1>{{ role.name }}</h1><div class="role-detail__badges"><img src="{{ element_icon }}" alt="" /><span class="role-detail__badge role-detail__grade-badge"><img src="{{ role.grade_icon }}" alt="" /></span><span class="role-detail__badge">Lv.{{ role.level }}</span></div><div class="role-detail__attributes">{% for item in attributes %}<div class="role-detail__attribute" style="background-image:url('{{ item.background }}')"><img src="{{ item.icon }}" alt="" /><span>{{ item.label }}</span><strong>{{ item.value }}</strong></div>{% endfor %}</div></div><div class="role-detail__grades">{% for grade in grades %}<div class="role-detail__grade" style="left:{{ grade.left }}px;background-image:url('{{ grade.background }}')"><img src="{{ grade.icon }}" alt="" /></div>{% endfor %}</div></section>
<img class="role-detail__divider" src="{{ divider }}" alt="" />
<section class="role-detail__skills">{% for item in skills %}<article class="role-detail__skill" style="background-image:url('{{ skill_background }}')"><img src="{{ item.icon }}" alt="" /><h3>{{ item.name }}</h3><p>Lv.{{ item.level }}</p></article>{% endfor %}</section>
{% for weapon in weapon_sections %}<section class="role-detail__weapon-section modes-{{ weapon.modes|length }}"><h2 class="role-detail__weapon-title">{{ weapon.title }}</h2><div class="role-detail__weapon-line" style="left:{{ 70 + weapon.title|length * 24 }}px"></div><div class="role-detail__weapon-modes">{% for mode in weapon.modes %}<article class="role-detail__mode mode-{{ mode.side }}"><img class="role-detail__mode-bg" src="{{ mode.background }}" alt="" /><div class="role-detail__mode-content">{% if mode.icon %}<img class="role-detail__mode-icon" src="{{ mode.icon }}" alt="" />{% endif %}<h4>{{ mode.name }}</h4>{% if mode.level %}<span class="role-detail__mode-level">{{ mode.level }}</span>{% endif %}</div></article>{% endfor %}</div><div class="role-detail__weapon-info"><div class="role-detail__weapon-card" style="background-image:url('{{ weapon.weapon_background }}')"><img class="role-detail__weapon-icon" src="{{ weapon.icon }}" alt="" /><span class="role-detail__weapon-level">Lv.{{ weapon.level }}</span></div><h3 class="role-detail__weapon-name">{{ weapon.name }}</h3><div class="role-detail__weapon-attrs" style="background-image:url('{{ weapon.attribute_background }}')">{% for attr in weapon.attributes %}<div class="role-detail__weapon-attr"><img src="{{ attr.icon }}" alt="" /><span>{{ attr.label }}</span><strong>{{ attr.value }}</strong></div>{% endfor %}</div></div></section>{% endfor %}
<img class="role-detail__divider" src="{{ divider }}" alt="" />
<section class="role-detail__mods">{% for mode in role_modes %}<article class="role-detail__mode mode-{{ mode.position }}"><img class="role-detail__mode-bg" src="{{ mode.background }}" alt="" /><div class="role-detail__mode-content">{% if mode.icon %}<img class="role-detail__mode-icon" src="{{ mode.icon }}" alt="" />{% endif %}<h4>{{ mode.name }}</h4>{% if mode.level %}<span class="role-detail__mode-level">{{ mode.level }}</span>{% endif %}</div></article>{% endfor %}</section>
<section class="role-detail__damage{% if damage.error %} is-error{% endif %}"><header class="role-detail__damage-head"><h2>伤害计算</h2><div>{{ damage.enemy }}<br />{{ damage.restraint }}</div></header><div class="role-detail__lineup">{% for item in damage.lineup %}<div><span>{{ item.label }}</span><strong>{{ item.name }}</strong></div>{% endfor %}</div>{% if damage.error %}<h3 class="role-detail__status">计算状态</h3><p class="role-detail__error">{{ damage.error }}</p>{% else %}<section class="role-detail__damage-section"><h3>角色属性</h3><dl class="role-detail__damage-grid">{% for item in damage.attributes %}<div><dt>{{ item.label }}</dt><dd>{{ item.value }}</dd></div>{% endfor %}</dl>{% if damage.weapons %}<ul class="role-detail__damage-weapons">{% for item in damage.weapons %}<li><span>{{ item.label }}</span><strong>{{ item.name }}</strong><b>{{ item.value }}</b></li>{% endfor %}</ul>{% endif %}</section>{% for skill in damage.skills %}<article class="role-detail__damage-skill"><header><h3>{{ skill.name }}</h3><span>Lv.{{ skill.level }}</span></header><dl class="role-detail__damage-grid">{% for item in skill.metrics %}<div><dt>{{ item.label }}</dt><dd>{{ item.value }}</dd></div>{% endfor %}</dl>{% for child in skill.children %}<section class="role-detail__damage-child"><h4>{{ child.name }}</h4><dl class="role-detail__damage-grid">{% for item in child.metrics %}<div><dt>{{ item.label }}</dt><dd>{{ item.value }}</dd></div>{% endfor %}</dl></section>{% endfor %}</article>{% endfor %}{% endif %}</section>
{{ legacy_profile_header(header, profile_background) }}
<footer class="role-detail__footer"><img src="{{ footer_image }}" alt="" /></footer>
{% endcall %}
