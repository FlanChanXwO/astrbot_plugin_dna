{% from "cards/macros/layout.html.j2" import card_shell %}
{% from "cards/macros/components.html.j2" import legacy_profile_header %}
{% call card_shell(width, height, background=background, class_name="sign-calendar") %}
<style>
  @font-face { font-family: "DNAUnicode"; src: url("{{ font }}") format("woff2"); }
  .sign-calendar { position: relative; width: 1300px; height: {{ height }}px; color: #fff; font-family: "DNAUnicode", sans-serif; }
  .sign-calendar .dna-legacy-profile { position: absolute; top: 30px; left: 0; margin: 0; }
  .sign-calendar__achievements { position: absolute; top: 300px; left: 0; width: 1300px; height: 88px; margin: 0; background: url("{{ achievement_background }}") 250px 0/775px 88px no-repeat; text-align: center; }
  .sign-calendar__achievements > div { position: absolute; top: 0; width: 215px; height: 88px; }.sign-calendar__achievements > div:nth-child(1) { left: 208px; }.sign-calendar__achievements > div:nth-child(2) { left: 423px; }.sign-calendar__achievements > div:nth-child(3) { left: 638px; }.sign-calendar__achievements > div:nth-child(4) { left: 853px; }
  .sign-calendar__achievements dt { margin-top: 7px; color: #fff; font-size: 50px; line-height: 55px; }.sign-calendar__achievements dd { margin: 0; color: #eee8aa; font-size: 25px; line-height: 30px; }
  .sign-calendar__divider { position: absolute; left: 120px; width: 1046px; height: 53px; }.sign-calendar__divider--community { top: 420px; }.sign-calendar__divider--game { top: {{ 520 + (tasks|length * 60 if tasks else 0) + (20 if tasks else 0) }}px; }
  .sign-calendar__tasks { position: absolute; top: 520px; left: 200px; width: 870px; }.sign-calendar__task { position: relative; width: 870px; height: 33px; margin: 0 0 27px; background: url("{{ task_background }}") center/870px 33px no-repeat; }.sign-calendar__status { position: absolute; top: 5px; left: 0; width: 32px; height: 32px; background: url("{{ red }}") center/32px 32px no-repeat; }.sign-calendar__status.done { background-image: url("{{ green }}"); }.sign-calendar__task-label { position: absolute; top: 0; left: 40px; font-size: 26px; line-height: 33px; white-space: nowrap; }.sign-calendar__track { position: absolute; top: 9px; left: 372px; width: 496px; height: 16px; overflow: hidden; border: 2px solid #fff; border-radius: 9px; box-sizing: border-box; }.sign-calendar__value { height: 100%; background: #fff; }
  .sign-calendar__awards { position: absolute; top: {{ 620 + (tasks|length * 60 if tasks else 0) + (20 if tasks else 0) }}px; left: 140px; display: grid; grid-template-columns: repeat(7, 124px); grid-auto-rows: 240px; column-gap: 21px; row-gap: 0; }.sign-calendar__award { position: relative; width: 124px; height: 219px; background: url("{{ item_background }}") center/124px 219px no-repeat; }.sign-calendar__award.current { outline: 3px solid #daa520; border-radius: 10px; }.sign-calendar__award-icon { position: absolute; top: 0; left: -8px; width: 140px; height: 140px; object-fit: contain; }.sign-calendar__award-status { position: absolute; top: 190px; left: 10px; width: 24px; height: 24px; }.sign-calendar__award p { position: absolute; right: 0; left: 0; margin: 0; color: #fff; font-size: 28px; text-align: center; }.sign-calendar__award p:first-of-type { bottom: 47px; }.sign-calendar__award p:last-of-type { bottom: 8px; color: #777; font-size: 20px; }.sign-calendar__award p.done { color: #4caf50; }
  .sign-calendar__footer { position: absolute; bottom: 20px; left: 350px; width: 600px; height: auto; }
</style>
{{ legacy_profile_header(header, header_background) }}
<dl class="sign-calendar__achievements">{% for item in achievements %}<div><dt>{{ item.value }}</dt><dd>{{ item.label }}</dd></div>{% endfor %}</dl>
<img class="sign-calendar__divider sign-calendar__divider--community" src="{{ divider_background }}" alt="" />
{% if tasks %}<section class="sign-calendar__tasks">{% for task in tasks %}<article class="sign-calendar__task"><span class="sign-calendar__status{% if task.done %} done{% endif %}"></span><span class="sign-calendar__task-label">{{ task.remark }}</span><div class="sign-calendar__track"><div class="sign-calendar__value" style="width: {{ task.progress * 100 }}%"></div></div></article>{% endfor %}</section>{% endif %}
<img class="sign-calendar__divider sign-calendar__divider--game" src="{{ divider_background }}" alt="" />
<section class="sign-calendar__awards">{% for award in awards %}<article class="sign-calendar__award{% if award.current %} current{% endif %}">{% if award.icon %}<img class="sign-calendar__award-icon" src="{{ award.icon }}" alt="" />{% endif %}<p>x{{ award.amount }}</p><img class="sign-calendar__award-status" src="{% if award.signed %}{{ green }}{% else %}{{ red }}{% endif %}" alt="" /><p class="{% if award.signed %}done{% endif %}">第{{ award.day }}天</p></article>{% endfor %}</section>
<img class="sign-calendar__footer" src="{{ footer_image }}" alt="" />
{% endcall %}
