{% macro progress_bar(label, current, total, ratio) -%}
<section class="dna-progress">
  <div class="dna-progress__label"><span>{{ label }}</span><span>{{ current }}/{{ total }}</span></div>
  <div class="dna-progress__track"><div class="dna-progress__value" style="width: {{ ratio * 100 }}%"></div></div>
</section>
{%- endmacro %}

{% macro legacy_profile_header(header, background) -%}
<header class="dna-legacy-profile">
  <img class="dna-legacy-profile__background" src="{{ background }}" alt="" />
  <img class="dna-legacy-profile__avatar" src="{{ header.avatar }}" alt="" />
  {% if header.avatar_frame %}<img class="dna-legacy-profile__avatar-frame" src="{{ header.avatar_frame }}" alt="" />{% endif %}
  <h1>{{ header.name }}</h1>
  {% if header.uid %}<p class="dna-legacy-profile__uid">UID {{ header.uid }}</p>{% endif %}
  {% if header.level is not none %}<div class="dna-legacy-profile__level"><img src="{{ header.level_background }}" alt="" /><span>{{ header.level }}</span></div>{% endif %}
  {% if header.stats|length >= 2 %}<dl style="background-image:url('{{ header.stats_background }}')">{% if header.stats|length >= 4 %}{% set stats = header.stats[:4] %}{% set start_x = 70 %}{% set next_x = 120 %}{% elif header.stats|length == 3 %}{% set stats = header.stats %}{% set start_x = 100 %}{% set next_x = 150 %}{% else %}{% set stats = header.stats %}{% set start_x = 150 %}{% set next_x = 200 %}{% endif %}{% for stat in stats %}<div style="left:{{ start_x + loop.index0 * next_x }}px"><dt>{{ stat.value }}</dt><dd>{{ stat.label }}</dd></div>{% endfor %}</dl>{% endif %}
</header>
{%- endmacro %}

{% macro resource_grid(items) -%}
<ul class="dna-resource-grid">
  {% for item in items %}
  <li class="dna-resource-grid__item">
    {% if item.image %}<img src="{{ item.image }}" alt="" />{% endif %}
    <span>{{ item.name }}</span><strong>{{ item.value }}</strong>
  </li>
  {% endfor %}
</ul>
{%- endmacro %}

{% macro weapon(item) -%}
<article class="dna-weapon">{% if item.image %}<img src="{{ item.image }}" alt="" />{% endif %}<div><h2>{{ item.name }}</h2><p>{{ item.level }}</p></div></article>
{%- endmacro %}

{% macro skill(item) -%}
<article class="dna-skill">{% if item.image %}<img src="{{ item.image }}" alt="" />{% endif %}<div><h2>{{ item.name }}</h2><p>{{ item.level }}</p></div></article>
{%- endmacro %}

{% macro damage_section(rows) -%}
<section class="dna-damage"><h2>伤害计算</h2><ul class="dna-list">{% for row in rows %}<li><span>{{ row.name }}</span><strong>{{ row.value }}</strong></li>{% endfor %}</ul></section>
{%- endmacro %}

{% macro profile_header(header) -%}
<header class="dna-profile">
  <img class="dna-profile__avatar" src="{{ header.avatar }}" alt="" />
  <div class="dna-profile__main">
    <h1>{{ header.name }}</h1>
    {% if header.uid %}<p class="dna-profile__uid">UID {{ header.uid }}</p>{% endif %}
    {% if header.level is not none %}<p class="dna-profile__level">Lv.{{ header.level }}</p>{% endif %}
  </div>
  {% if header.stats %}<dl class="dna-profile__stats">{% for stat in header.stats %}<div><dt>{{ stat.value }}</dt><dd>{{ stat.label }}</dd></div>{% endfor %}</dl>{% endif %}
</header>
{%- endmacro %}
