{% macro card_shell(width, height=none, background=none, class_name='') -%}
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width={{ width }}, height={{ height or 800 }}, initial-scale=1" />
    <style>
      * { box-sizing: border-box; }
      html, body { width: 100%; min-height: 100%; margin: 0; padding: 0; }
      body { color: #f8f7f2; background: transparent; font-family: "Microsoft YaHei", sans-serif; }
      .dna-card { position: relative; width: {{ width }}px; overflow: hidden; background: #1c2233; }
      .dna-card--fixed { height: {{ height }}px; min-height: {{ height }}px; }
      .dna-card__background { position: absolute; inset: 0; z-index: 0; width: 100%; height: 100%; object-fit: cover; }
      .dna-card__content { position: relative; z-index: 1; min-height: inherit; }
      .dna-header { display: flex; gap: 18px; align-items: center; padding: 28px 40px; }
      .dna-header__avatar { width: 88px; height: 88px; border-radius: 50%; object-fit: cover; }
      .dna-header__title { margin: 0; color: #fff; font-size: 34px; }
      .dna-header__subtitle { margin: 8px 0 0; color: #dfd2a1; font-size: 20px; }
      .dna-divider { height: 2px; margin: 0 40px; background: rgba(234, 211, 143, .75); }
      .dna-footer { padding: 18px 40px; color: rgba(255, 255, 255, .72); font-size: 16px; text-align: center; }
      .dna-list { margin: 0; padding: 0; list-style: none; }
      .dna-progress { padding: 14px 40px; }
      .dna-progress__label { display: flex; justify-content: space-between; margin-bottom: 8px; }
      .dna-progress__track { height: 14px; overflow: hidden; border-radius: 8px; background: rgba(255, 255, 255, .22); }
      .dna-progress__value { height: 100%; border-radius: inherit; background: #ebd48f; }
      .dna-resource-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; margin: 0; padding: 24px 40px; list-style: none; }
      .dna-resource-grid__item { display: grid; gap: 6px; justify-items: center; text-align: center; }
      .dna-resource-grid__item img { width: 86px; height: 86px; object-fit: contain; }
      .dna-weapon, .dna-skill { display: flex; gap: 14px; align-items: center; padding: 16px 40px; }
      .dna-weapon img, .dna-skill img { width: 68px; height: 68px; object-fit: contain; }
      .dna-weapon h2, .dna-skill h2, .dna-damage h2 { margin: 0; font-size: 24px; }
      .dna-weapon p, .dna-skill p { margin: 6px 0 0; color: #dfd2a1; }
      .dna-damage { padding: 24px 40px; }
      .dna-damage li { display: flex; justify-content: space-between; padding: 8px 0; }
      .dna-profile { display: flex; gap: 20px; align-items: center; min-height: 210px; padding: 24px 60px; }
      .dna-profile__avatar { width: 150px; height: 150px; border: 4px solid rgba(238,232,170,.8); border-radius: 50%; object-fit: cover; }
      .dna-profile__main { min-width: 260px; }
      .dna-profile__main h1 { margin: 0; color: #fff; font-size: 42px; }
      .dna-profile__uid, .dna-profile__level { display: inline-block; margin: 10px 8px 0 0; padding: 4px 12px; border-radius: 14px; background: rgba(238,232,170,.88); color: #222; font-size: 18px; }
      .dna-profile__stats { display: flex; flex: 1; justify-content: flex-end; gap: 28px; margin: 0 0 0 auto; text-align: center; }
      .dna-profile__stats div { min-width: 100px; }
      .dna-profile__stats dt { color: #fff; font-size: 28px; }
      .dna-profile__stats dd { margin: 6px 0 0; color: #eee8aa; font-size: 16px; }
      .dna-legacy-profile { position: relative; width: 1300px; height: 234px; margin: 30px 0 0 -50px; color: #fff; font-family: "DNAUnicode", sans-serif; }
      .dna-legacy-profile__background { position: absolute; inset: 0; width: 1300px; height: 234px; }
      .dna-legacy-profile__avatar { position: absolute; top: 50px; left: 145px; width: 130px; height: 130px; object-fit: fill; }
      .dna-legacy-profile__avatar-frame { position: absolute; top: 20px; left: 115px; width: 190px; height: 190px; }
      .dna-legacy-profile h1 { position: absolute; top: 70px; left: 320px; height: 60px; margin: 0; color: #fff; font-size: 50px; font-weight: 400; line-height: 60px; }
      .dna-legacy-profile__uid { position: absolute; top: 140px; left: 320px; width: 330px; height: 40px; margin: 0; padding: 0 10px; border-radius: 15px; background: #eee8aa; color: #000; font-size: 30px; font-weight: 400; line-height: 40px; white-space: nowrap; }
      .dna-legacy-profile__level { position: absolute; top: 140px; left: 235px; width: 70px; height: 70px; overflow: hidden; }
      .dna-legacy-profile__level img { position: absolute; top: 0; left: 0; width: 74px; height: 76px; }
      .dna-legacy-profile__level span { position: absolute; top: 2px; left: 0; width: 70px; height: 66px; color: #fff; font-size: 24px; font-weight: 400; line-height: 66px; text-align: center; }
      .dna-legacy-profile dl { position: absolute; top: 90px; left: 680px; width: 492px; height: 90px; margin: 0; background: center/492px 90px no-repeat; text-align: center; }
      .dna-legacy-profile dl div { position: absolute; top: 0; width: 120px; height: 90px; transform: translateX(-60px); }
      .dna-legacy-profile dt { height: 46px; margin: 0; color: #fff; font-size: 40px; font-weight: 400; line-height: 46px; }
      .dna-legacy-profile dd { height: 34px; margin: 0; color: #fff; font-size: 20px; font-weight: 400; line-height: 34px; }
    </style>
  </head>
  <body>
    <main class="dna-card {{ class_name }}{% if height is not none %} dna-card--fixed{% endif %}">
      {% if background %}<img class="dna-card__background" src="{{ background }}" alt="" />{% endif %}
      <section class="dna-card__content">{{ caller() }}</section>
    </main>
  </body>
</html>
{%- endmacro %}

{% macro avatar_title(avatar, title, subtitle='') -%}
<header class="dna-header">
  {% if avatar %}<img class="dna-header__avatar" src="{{ avatar }}" alt="" />{% endif %}
  <div><h1 class="dna-header__title">{{ title }}</h1>{% if subtitle %}<p class="dna-header__subtitle">{{ subtitle }}</p>{% endif %}</div>
</header>
{%- endmacro %}

{% macro divider() -%}<div class="dna-divider"></div>{%- endmacro %}

{% macro footer(text='Power By AstrBot & Copyright 二重 螺旋') -%}<footer class="dna-footer">{{ text }}</footer>{%- endmacro %}
