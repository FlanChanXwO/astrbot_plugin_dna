{% from "cards/macros/layout.html.j2" import card_shell %}
{% call card_shell(width, height, background=background, class_name="calendar-card") %}
<style>
  @font-face { font-family: "DNAUnicode"; src: url("{{ font }}") format("woff2"); }
  .calendar-card { position: relative; width: 1200px; height: {{ height }}px; color: #fff; font-family: "DNAUnicode", sans-serif; overflow: hidden; }
  .calendar-card__title { position: absolute; top: 115px; left: 0; width: 1200px; margin: 0; font-size: 50px; line-height: 70px; text-align: center; z-index: 2; }
  .calendar-card__banner { position: absolute; top: 150px; left: 0; width: 1200px; height: 600px; object-fit: fill; z-index: 1; }
  .calendar-card__bar { position: absolute; top: 720px; left: 0; width: 1200px; height: 60px; z-index: 2; }
  .calendar-card__event { position: absolute; width: 530px; height: 180px; background: url("{{ event_background }}") center/530px 180px no-repeat; }
  .calendar-card__event h2 { position: absolute; top: 28px; left: 40px; margin: 0; color: #daa520; font-size: 30px; line-height: 36px; }
  .calendar-card__event .date { position: absolute; top: 76px; left: 40px; margin: 0; font-size: 20px; line-height: 30px; }
  .calendar-card__event .status { position: absolute; top: 110px; left: 70px; margin: 0; font-size: 20px; line-height: 30px; }
  .calendar-card__event .time-icon { position: absolute; top: 115px; left: 35px; width: 30px; height: 30px; }.calendar-card__track { position: absolute; top: 155px; left: 25px; width: 485px; height: 8px; background: #646464; }.calendar-card__value { height: 100%; background: gold; }
  .calendar-card__event-icon { position: absolute; top: 40px; left: 400px; width: 100px; height: 100px; object-fit: contain; }
  .calendar-card__footer { position: absolute; bottom: 20px; left: 70px; width: 1060px; height: 40px; }
</style>
<h1 class="calendar-card__title">DNA | 二重螺旋活动列表一栏 | 皎皎角</h1>
<img class="calendar-card__banner" src="{{ banner }}" alt="" /><img class="calendar-card__bar" src="{{ bar }}" alt="" />
{% for event in events %}<article class="calendar-card__event" style="left: {{ 70 + (loop.index0 % 2) * 540 }}px; top: {{ 780 + (loop.index0 // 2) * 170 }}px"><h2>{{ event.title }}</h2><p class="date">{{ event.date_range }}</p><img class="time-icon" src="{{ time_icon }}" alt="" /><p class="status">{{ event.status }}{% if event.left %}: <span class="left" style="color:{{ event.left_color }}">{{ event.left }}</span>{% endif %}</p><div class="calendar-card__track"><div class="calendar-card__value" style="width: {{ event.progress * 100 }}%;background:{{ event.progress_color }}"></div></div>{% if event.icon %}<img class="calendar-card__event-icon" src="{{ event.icon }}" alt="" />{% endif %}</article>{% endfor %}
<img class="calendar-card__footer" src="{{ footer_image }}" alt="" />
{% endcall %}
