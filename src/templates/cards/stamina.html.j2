{% from "cards/macros/layout.html.j2" import card_shell, footer %}
{% from "cards/macros/components.html.j2" import legacy_profile_header %}
{% call card_shell(width, height, background=background, class_name="stamina-card") %}
<style>
  @font-face { font-family: "DNAUnicode"; src: url("{{ font }}") format("woff2"); }
  .stamina-card { min-height: {{ height }}px; color: #fff; font-family: "DNAUnicode", sans-serif; }
  .stamina-card__foreground { position: absolute; inset: 0; z-index: 1; width: 2000px; height: 1100px; }
  .stamina-card__divider { position: absolute; top: 300px; left: 80px; z-index: 2; }
  .stamina-card .dna-legacy-profile { position: absolute; top: 30px; left: -50px; z-index: 2; margin: 0; }
  .stamina-card__notes { position: absolute; top: 400px; left: 80px; z-index: 2; display: grid; gap: 39px; width: 1078px; }
  .stamina-card__note { position: relative; display: grid; grid-template-columns: 110px 1fr auto; gap: 20px; align-items: center; width: 1078px; height: 111px; padding: 0 30px; background: url("{{ bar_background }}") center/1078px 111px no-repeat; }
  .stamina-card__note img { width: 70px; height: 70px; object-fit: contain; }
  .stamina-card__note strong { font-size: 36px; }.stamina-card__note span { font-size: 36px; }
  .stamina-card__track { height: 16px; overflow: hidden; border-radius: 9px; background: rgba(255,255,255,.25); }.stamina-card__value { height: 100%; background: #fff; }
  .stamina-card__drafts { position: absolute; inset: 0; z-index: 2; }
  .stamina-card__draft { position: absolute; left: 1400px; width: 573px; height: 76px; background: url("{{ draft_background }}") center/573px 76px no-repeat; }
  .stamina-card__draft img { position: absolute; top: 22px; left: 65px; width: 32px; height: 31px; }
  .stamina-card__draft-name { position: absolute; top: 10px; left: 115px; margin: 0; font-size: 36px; line-height: 46px; }
  .stamina-card__draft-state { position: absolute; top: 10px; right: 73px; margin: 0; font-size: 30px; line-height: 44px; }.stamina-card__draft.done .stamina-card__draft-state { color: #4caf50; }
  .stamina-card__footer { position: absolute; bottom: 20px; left: 700px; z-index: 2; color: rgba(255,255,255,.8); font-size: 18px; }
</style>
<img class="stamina-card__foreground" src="{{ foreground }}" alt="" />
<img class="stamina-card__divider" src="{{ divider }}" alt="" />
{{ legacy_profile_header(header, header_background) }}
<section class="stamina-card__notes">{% for note in notes %}<article class="stamina-card__note">{% if note.icon %}<img src="{{ note.icon }}" alt="" />{% endif %}<div><strong>{{ note.name }}</strong><div class="stamina-card__track"><div class="stamina-card__value" style="width: {{ note.ratio * 100 }}%"></div></div></div><span>{{ note.current }}/{{ note.total }}</span></article>{% endfor %}</section>
{% if drafts %}<section class="stamina-card__drafts">{% for draft in drafts %}<article class="stamina-card__draft{% if draft.done %} done{% endif %}" style="top:{{ 980 - loop.index * 100 }}px"><img src="{% if draft.done %}{{ success }}{% else %}{{ running }}{% endif %}" alt="" /><span class="stamina-card__draft-name">{{ draft.name }}</span><span class="stamina-card__draft-state">{{ draft.state }}</span></article>{% endfor %}</section>{% endif %}
<p class="stamina-card__footer">Power By AstrBot &amp; Copyright 二重 螺旋</p>
{% endcall %}
