{% from "cards/macros/layout.html.j2" import card_shell %}
{% call card_shell(width, background=background, class_name="weapon-detail") %}
<style>
  @font-face { font-family: "DNAFont"; src: url("{{ font }}") format("woff2"); }
  .weapon-detail { width: 1000px; color: #fff; font-family: "DNAFont", sans-serif; overflow: hidden; background: #080a12; }
  .weapon-detail__hero { position: relative; min-height: 700px; overflow: hidden; border-bottom: 1px solid rgba(238,232,170,.28); background: linear-gradient(112deg, rgba(7,9,16,.12) 0 58%, rgba(7,9,16,.82) 58% 100%); }
  .weapon-detail__hero::before { content: ""; position: absolute; left: 48px; top: 50px; width: 560px; height: 560px; border: 1px solid rgba(238,232,170,.18); border-radius: 50%; box-shadow: inset 0 0 90px rgba(112,83,189,.22), 0 0 90px rgba(59,38,105,.18); }
  .weapon-detail__hero::after { content: "WEAPON ARCHIVE"; position: absolute; left: 60px; bottom: 34px; color: rgba(255,255,255,.18); font-family: sans-serif; font-size: 18px; letter-spacing: 8px; }
  .weapon-detail__visual { position: absolute; left: 26px; top: 26px; width: 600px; height: 610px; display: flex; align-items: center; justify-content: center; }
  .weapon-detail__weapon-frame { position: absolute; width: 570px; height: 570px; object-fit: contain; opacity: .7; }
  .weapon-detail__weapon-icon { position: relative; width: 540px; height: 540px; object-fit: contain; filter: drop-shadow(0 30px 30px rgba(0,0,0,.72)); transform: rotate(-4deg); }
  .weapon-detail__identity { position: absolute; right: 42px; top: 58px; width: 366px; }
  .weapon-detail__kicker { margin: 0 0 14px; color: #eee8aa; font-family: sans-serif; font-size: 15px; letter-spacing: 5px; }
  .weapon-detail__identity h1 { margin: 0; color: #fff7cf; font-size: 52px; font-weight: 400; line-height: 1.12; text-shadow: 0 4px 18px rgba(0,0,0,.72); }
  .weapon-detail__levels { display: flex; gap: 10px; margin: 18px 0 22px; }
  .weapon-detail__badge { padding: 7px 13px; border: 1px solid rgba(238,232,170,.4); border-radius: 999px; background: rgba(6,8,14,.58); color: #eee8aa; font-size: 18px; }
  .weapon-detail__specs { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 10px; padding: 18px 16px; background-position: center; background-size: 100% 100%; }
  .weapon-detail__spec { display: grid; grid-template-columns: 38px 1fr; grid-template-rows: 20px 26px; min-height: 58px; padding: 8px 10px; background: rgba(5,7,12,.34); }
  .weapon-detail__spec img { grid-row: 1 / 3; width: 34px; height: 34px; align-self: center; object-fit: contain; }
  .weapon-detail__spec span { color: rgba(255,255,255,.62); font-size: 14px; line-height: 20px; }
  .weapon-detail__spec strong { color: #fff; font-size: 21px; font-weight: 400; line-height: 26px; }
  .weapon-detail__modules { padding: 38px 44px 44px; background: linear-gradient(180deg, rgba(9,10,18,.58), rgba(5,6,11,.88)); }
  .weapon-detail__section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 24px; }
  .weapon-detail__section-head h2 { margin: 0; color: #fff7cf; font-size: 30px; font-weight: 400; }
  .weapon-detail__section-head span { color: rgba(255,255,255,.42); font-family: sans-serif; font-size: 14px; letter-spacing: 4px; }
  .weapon-detail__module-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
  .weapon-detail__module { position: relative; min-width: 0; height: 224px; overflow: hidden; }
  .weapon-detail__module-frame { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: fill; }
  .weapon-detail__module.is-empty { opacity: .42; }
  .weapon-detail__module-icon { position: relative; display: block; width: 154px; height: 154px; margin: 12px auto 0; object-fit: contain; filter: drop-shadow(0 10px 12px rgba(0,0,0,.55)); }
  .weapon-detail__module h3 { position: absolute; right: 24px; bottom: 26px; left: 24px; margin: 0; overflow: hidden; color: #fff; font-size: 17px; font-weight: 400; text-align: center; text-overflow: ellipsis; white-space: nowrap; }
  .weapon-detail__module-level { position: absolute; top: 12px; right: 12px; min-width: 40px; padding: 4px 8px; border-radius: 999px; background: #d94b2b; font-size: 18px; text-align: center; }
  .weapon-detail__profile { position: relative; width: 1000px; height: 190px; overflow: hidden; background: rgba(5,6,10,.92); }
  .weapon-detail__profile-bg { position: absolute; inset: 0; width: 100%; height: 190px; object-fit: fill; }
  .weapon-detail__avatar { position: absolute; left: 42px; top: 18px; width: 150px; height: 150px; border-radius: 50%; object-fit: cover; }
  .weapon-detail__avatar-frame { position: absolute; left: 26px; top: 2px; width: 182px; height: 182px; object-fit: contain; }
  .weapon-detail__profile-main { position: absolute; left: 226px; top: 40px; }
  .weapon-detail__profile-main h2 { margin: 0 0 8px; color: #fff7cf; font-size: 38px; font-weight: 400; }
  .weapon-detail__uid { margin: 0; color: rgba(255,255,255,.7); font-family: sans-serif; font-size: 18px; letter-spacing: 2px; }
  .weapon-detail__player-level { position: absolute; left: 218px; top: 112px; width: 118px; height: 48px; text-align: center; }
  .weapon-detail__player-level img { position: absolute; inset: 0; width: 118px; height: 48px; object-fit: fill; }
  .weapon-detail__player-level span { position: relative; color: #fff; font-size: 23px; line-height: 48px; }
  .weapon-detail__stats { position: absolute; right: 48px; top: 52px; display: flex; gap: 18px; margin: 0; }
  .weapon-detail__stats div { min-width: 150px; padding: 14px 20px; text-align: center; background-position: center; background-size: 100% 100%; }
  .weapon-detail__stats dt { color: #fff7cf; font-size: 24px; }
  .weapon-detail__stats dd { margin: 4px 0 0; color: rgba(255,255,255,.62); font-size: 15px; }
  .weapon-detail__footer { position: relative; width: 1000px; height: 72px; background: rgba(4,5,9,.92); }
  .weapon-detail__footer img { position: absolute; right: 200px; bottom: 18px; width: 600px; height: 23px; object-fit: fill; opacity: .76; }
</style>
<article data-weapon-card="archive">
  <section class="weapon-detail__hero">
    <div class="weapon-detail__visual">{% if weapon.weapon_background %}<img class="weapon-detail__weapon-frame" src="{{ weapon.weapon_background }}" alt="" />{% endif %}<img class="weapon-detail__weapon-icon" src="{{ weapon.icon }}" alt="" /></div>
    <div class="weapon-detail__identity">
      <p class="weapon-detail__kicker">WEAPON / {{ weapon.attributes[0].value }}</p>
      <h1>{{ weapon.name }}</h1>
      <div class="weapon-detail__levels"><span class="weapon-detail__badge">Lv.{{ weapon.level }}</span><span class="weapon-detail__badge">精炼等级 {{ weapon.skill_level }}</span></div>
      <div class="weapon-detail__specs" style="background-image:url('{{ weapon.attribute_background }}')">{% for attr in weapon.attributes %}<div class="weapon-detail__spec"><img src="{{ attr.icon }}" alt="" /><span>{{ attr.label }}</span><strong>{{ attr.value }}</strong></div>{% endfor %}</div>
    </div>
  </section>
  <section class="weapon-detail__modules modules-{{ weapon.modes|length }}">
    <div class="weapon-detail__section-head"><h2>魔之楔配置</h2><span>MODULE MATRIX</span></div>
    <div class="weapon-detail__module-grid">{% for mode in weapon.modes %}<article class="weapon-detail__module{% if not mode.icon %} is-empty{% endif %}"><img class="weapon-detail__module-frame" src="{{ mode.background }}" alt="" />{% if mode.icon %}<img class="weapon-detail__module-icon" src="{{ mode.icon }}" alt="" />{% endif %}{% if mode.name %}<h3>{{ mode.name }}</h3>{% endif %}{% if mode.level %}<span class="weapon-detail__module-level">{{ mode.level }}</span>{% endif %}</article>{% endfor %}</div>
  </section>
  <section class="weapon-detail__profile">
    <img class="weapon-detail__profile-bg" src="{{ profile_background }}" alt="" />
    <img class="weapon-detail__avatar" src="{{ header.avatar }}" alt="" />
    {% if header.avatar_frame %}<img class="weapon-detail__avatar-frame" src="{{ header.avatar_frame }}" alt="" />{% endif %}
    <div class="weapon-detail__profile-main"><h2>{{ header.name }}</h2>{% if header.uid %}<p class="weapon-detail__uid">UID {{ header.uid }}</p>{% endif %}</div>
    {% if header.level is not none %}<div class="weapon-detail__player-level"><img src="{{ header.level_background }}" alt="" /><span>Lv.{{ header.level }}</span></div>{% endif %}
    {% if header.stats %}<dl class="weapon-detail__stats">{% for stat in header.stats[:2] %}<div style="background-image:url('{{ header.stats_background }}')"><dt>{{ stat.value }}</dt><dd>{{ stat.label }}</dd></div>{% endfor %}</dl>{% endif %}
  </section>
</article>
<footer class="weapon-detail__footer"><img src="{{ footer_image }}" alt="" /></footer>
{% endcall %}
