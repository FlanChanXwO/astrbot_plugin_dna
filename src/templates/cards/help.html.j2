{% from "cards/macros/layout.html.j2" import card_shell %}
{% call card_shell(width, card_height, background=background, class_name="help-card") %}
<style>
  @font-face { font-family: "DNAUnicode"; src: url("{{ font }}") format("woff2"); }
  .help-card { position: relative; width: 2020px; font-family: "DNAUnicode", sans-serif; font-weight: 630; }
  .help-card__banner { position: absolute; top: 0; left: 0; width: 2020px; height: 784px; object-fit: fill; }
  .help-card__icon-frame { position: absolute; top: 507px; left: 116px; width: 175px; height: 175px; border: 8px solid rgba(255, 255, 255, .85); border-radius: 50%; overflow: hidden; box-sizing: border-box; }
  .help-card__icon { display: block; width: 100%; height: 100%; object-fit: cover; }
  .help-card__heading { position: absolute; top: 515px; left: 343px; display: flex; gap: 24px; align-items: center; min-height: 72px; }
  .help-card__title { margin: 0; color: #fff; font-size: 65px; font-weight: 630; line-height: 72px; }
  .help-card__subtitle { position: absolute; top: 631px; left: 343px; margin: 0; color: #cecece; font-size: 39px; line-height: 39px; transform: translateY(-50%); }
  .help-card__badge { display: inline-block; padding: 8px 24px; border-radius: 24px; background: #fc4545; color: #fff; font-size: 39px; font-weight: 630; line-height: 50px; }
  .help-card__sections { position: relative; padding-top: 766px; }
  .help-card__sections--fallback { padding-top: 900px; }
  .help-card__section { position: relative; left: 0; width: 2020px; overflow: visible; }
  .help-card__section-bar { position: absolute; top: 0; left: 0; width: 2020px; height: 130px; object-fit: fill; }
  .help-card__section-heading { position: absolute; top: 65px; left: 178px; display: flex; align-items: center; height: 59px; transform: translateY(-50%); }
  .help-card__section-title { margin: 0; color: #fff; font-size: 59px; font-weight: 630; line-height: 59px; }
  .help-card__section-desc { position: relative; top: 7px; margin: 0 0 0 20px; color: #cecece; font-size: 39px; line-height: 39px; }
  .help-card__items { position: absolute; top: 119px; left: 45px; width: 1960px; }
  .help-card__item { position: absolute; width: 490px; height: 175px; overflow: hidden; background: url("{{ item_background }}") center/490px 175px no-repeat; }
  .help-card__item-icon { position: absolute; top: 12px; left: 6px; width: 150px; height: 150px; object-fit: contain; }
  .help-card__item-name { position: absolute; top: 67px; left: 156px; margin: 0; color: #fff; font-size: 38px; line-height: 38px; white-space: nowrap; transform: translateY(-50%); }
  .help-card__item-example { position: absolute; top: 116px; left: 156px; margin: 0; color: #cecece; font-size: 26px; line-height: 26px; white-space: nowrap; transform: translateY(-50%); }
  .help-card__footer { position: relative; display: block; width: 1060px; height: 40px; margin: 32px auto 40px; }
</style>
{% if banner %}<img class="help-card__banner" src="{{ banner }}" alt="" />{% endif %}
{% if icon %}<div class="help-card__icon-frame">
  <img class="help-card__icon" src="{{ icon }}" alt="" />
</div>{% endif %}
<div class="help-card__heading">
  <h1 class="help-card__title">DNA帮助</h1>
  <span class="help-card__badge">{{ version }}</span>
</div>
{% if subtitle %}<p class="help-card__subtitle">{{ subtitle }}</p>{% endif %}
<div class="help-card__sections{% if not sections %} help-card__sections--fallback{% endif %}">
{% for section in sections %}
<section class="help-card__section" style="height: {{ section["height"] }}px">
  {% if cag_background %}<img class="help-card__section-bar" src="{{ cag_background }}" alt="" />{% endif %}
  <div class="help-card__section-heading">
    <h2 class="help-card__section-title">{{ section.name }}</h2>
    <p class="help-card__section-desc">{{ section.description }}</p>
  </div>
  <div class="help-card__items">
    {% for item in section["items"] %}
    <article class="help-card__item" style="left: {{ (loop.index0 % 4) * 490 }}px; top: {{ (loop.index0 // 4) * 175 }}px">
      {% if item.icon %}<img class="help-card__item-icon" src="{{ item.icon }}" alt="" />{% endif %}
      <p class="help-card__item-name">{{ item.name }}</p>
      <p class="help-card__item-example">{{ item.example }}</p>
    </article>
    {% endfor %}
  </div>
</section>
{% endfor %}
{% if not sections %}
<section class="help-card__section" style="height: {{ 175 * (((lines|length + 3) // 4) or 1) }}px">
<div class="help-card__items" style="top: 0; left: 45px">
  {% for line in lines %}
  <article class="help-card__item" style="left: {{ (loop.index0 % 4) * 490 }}px; top: {{ (loop.index0 // 4) * 175 }}px">
    <p class="help-card__item-name">{{ line.name }}</p>
    <p class="help-card__item-example">{{ line.example }}</p>
  </article>
  {% endfor %}
</div>
</section>
{% endif %}
</div>
{% if footer %}<img class="help-card__footer" src="{{ footer }}" alt="" />{% endif %}
{% endcall %}
