<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#141316" />
    <meta name="referrer" content="no-referrer" />
    <title>狩月终端 登录</title>
    <link rel="icon" href="{{ plugin_logo }}" type="image/png" />
    <style>
      :root {
        color-scheme: dark;
        --ink: #edeae2;
        --muted: #8c8982;
        --accent: #c4a062;
        --accent-light: #dfc48e;
        --surface: #202020;
        --input-bg: #272727;
        --border-color: #383838;
        --line: rgba(196, 160, 98, 0.22);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
        font-synthesis: none;
      }
      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      html, body { margin: 0; min-height: 100%; }
      body {
        min-height: 100vh;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        color: var(--ink);
        background: #18181a;
        isolation: isolate;
      }
      button, input { font: inherit; }
      button { cursor: pointer; touch-action: manipulation; }
      button:disabled { cursor: not-allowed; }
      button:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 4px;
      }
      .scene {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        pointer-events: none;
        background: #242128 url('https://herobox-img.yingxiong.com/post/1748784746036602530.jpg') center / cover no-repeat;
      }
      .scene::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(12, 12, 16, 0.12) 35%, rgba(12, 12, 16, 0.58)),
          linear-gradient(0deg, rgba(12, 12, 16, 0.55), transparent 30%, transparent 80%, rgba(12, 12, 16, 0.35));
      }
      .background-video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 35%;
        opacity: 0;
        transition: opacity 240ms ease;
      }
      .background-video.is-ready { opacity: 1; }
      .site-header {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        max-width: 1600px;
        margin-inline: auto;
        padding: max(32px, env(safe-area-inset-top)) clamp(24px, 5vw, 80px) 0;
        z-index: 2;
      }
      .brand-title-logo {
        display: block;
        height: clamp(38px, 5.5vw, 56px);
        width: auto;
        max-width: 85vw;
        object-fit: contain;
        filter: drop-shadow(0 4px 18px rgba(0, 0, 0, 0.7));
      }
      .logo-text {
        font-size: 18px;
        font-weight: 650;
        letter-spacing: 0.16em;
        text-shadow: 0 2px 12px #141316;
      }
      .login-container {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        width: 100%;
        max-width: 1600px;
        margin-inline: auto;
        padding: 48px clamp(24px, 5vw, 80px) 88px;
      }
      .form-panel {
        width: 408px;
        max-width: 100%;
        padding: 30px 32px 32px;
        background: #202020;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        box-shadow: 0 24px 72px rgba(0, 0, 0, 0.55);
      }
      .form-toolbar {
        min-height: 44px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 2px;
      }
      .form-eyebrow {
        margin: 0;
        color: var(--accent);
        font-size: 13px;
        letter-spacing: 0.12em;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
      h1 {
        margin: 4px 0 28px;
        font-size: clamp(24px, 2.1vw, 28px);
        font-weight: 600;
        line-height: 1.4;
        letter-spacing: 0.02em;
      }
      .input-group { margin-bottom: 20px; }
      label {
        display: block;
        margin-bottom: 9px;
        font-size: 13px;
        color: var(--muted);
      }
      .input-shell {
        display: flex;
        align-items: center;
        min-width: 0;
        min-height: 50px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background: var(--input-bg);
        transition: border-color 180ms ease, background-color 180ms ease;
      }
      .input-shell:focus-within {
        border-color: var(--accent);
        background: #2c2c2c;
        box-shadow: 0 0 0 2px rgba(196, 160, 98, 0.2);
      }
      .phone-prefix {
        flex: none;
        margin-left: 16px;
        padding-right: 14px;
        border-right: 1px solid #3e3e3e;
        font-size: 14px;
        color: var(--muted);
      }
      input {
        width: 100%;
        min-width: 0;
        height: 48px;
        padding: 12px 14px;
        color: var(--ink);
        background: transparent;
        border: 0;
        border-radius: 8px;
        outline: none;
        font-size: 15px;
        line-height: 1.5;
      }
      input::placeholder { color: #787878; opacity: 1; }
      input:-webkit-autofill {
        -webkit-text-fill-color: var(--ink);
        box-shadow: 0 0 0 60px #272727 inset;
        caret-color: var(--ink);
      }
      #verificationCode { letter-spacing: 0.16em; }
      #verificationCode::placeholder { letter-spacing: 0; }
      .verification-divider {
        display: block;
        width: 1px;
        height: 18px;
        background: #424242;
        flex: none;
        margin: 0 4px;
      }
      #getCodeBtn {
        flex: none;
        min-width: 90px;
        min-height: 44px;
        padding: 0 14px;
        color: var(--accent-light);
        background: transparent;
        border: 0;
        border-radius: 0 8px 8px 0;
        font-size: 13px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        transition: color 180ms ease;
      }
      #getCodeBtn:hover:not(:disabled) { color: #ffffff; }
      #getCodeBtn:disabled { color: #787878; }
      #loginBtn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        width: 100%;
        min-height: 50px;
        margin-top: 26px;
        padding: 13px 18px;
        color: #17150f;
        background: linear-gradient(135deg, var(--accent-light), var(--accent));
        border: 0;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 650;
        letter-spacing: 0.12em;
        box-shadow: 0 8px 20px rgba(196, 160, 98, 0.25);
        transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
      }
      #loginBtn svg { width: 18px; height: 18px; }
      #loginBtn:hover:not(:disabled) { background: #f4e0c4; transform: translateY(-1px); }
      #loginBtn:active:not(:disabled) { background: var(--accent); transform: translateY(0); }
      #loginBtn:disabled {
        color: #787878;
        background: #373737;
        box-shadow: none;
        border: 0;
        cursor: not-allowed;
      }
      .form-status {
        margin: 16px 0 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.65;
        overflow-wrap: anywhere;
      }
      .form-status:empty { display: none; }
      .form-status[data-kind='error'] { color: #ffb4b9; }
      .form-status[data-kind='success'] { color: #d7e7bd; }
      @media (max-width: 720px) {
        .scene {
          inset: 0;
          height: 100%;
          min-height: 100%;
          background-position: 50% 25%;
        }
        .background-video { object-position: 50% 25%; }
        .scene::after {
          background: linear-gradient(180deg, rgba(20, 19, 22, 0.35), rgba(20, 19, 22, 0.2) 40%, rgba(20, 19, 22, 0.65) 100%);
        }
        .site-header {
          padding: max(20px, env(safe-area-inset-top)) 16px 0;
        }
        .brand-title-logo {
          height: clamp(34px, 8.5vw, 46px);
        }
        .login-container {
          flex: 1;
          align-items: center;
          justify-content: center;
          padding: 20px max(16px, env(safe-area-inset-right)) max(28px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));
        }
        .form-panel { width: 408px; padding: 22px 24px 26px; border-radius: 18px; }
        h1 { margin-bottom: 24px; font-size: 25px; }
        .input-group { margin-bottom: 18px; }
        #loginBtn { margin-top: 24px; }
      }
      @media (max-width: 360px) {
        .form-panel { padding-inline: 20px; }
        h1 { font-size: 23px; }
        #getCodeBtn { min-width: 80px; padding-inline: 8px; }
      }
      @media (max-height: 520px) and (min-width: 721px) {
        .site-header { padding-top: max(20px, env(safe-area-inset-top)); }
        .login-container { padding-block: 24px; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { transition: none !important; scroll-behavior: auto !important; }
      }
    </style>
  </head>
  <body>
    <div class="scene" aria-hidden="true">
      {% if login_media and login_media.video_url %}
      <video id="backgroundVideo" class="background-video" loop muted playsinline preload="none"
        disablepictureinpicture data-video-src="{{ login_media.video_url | e }}"></video>
      {% endif %}
    </div>
    <header class="site-header">
      <img class="brand-title-logo" src="{{ title_logo | default(plugin_logo) }}" alt="狩月终端 Logo" />
      <div class="logo-text sr-only">狩月终端</div>
    </header>
    <main class="login-container">
      <section class="form-panel" aria-labelledby="loginHeading">
        <form id="loginForm">
          <div class="form-toolbar">
            <p class="form-eyebrow">皎皎角账号</p>
          </div>
          <h1 id="loginHeading">登录狩月终端</h1>
          <div class="input-group">
            <label for="phone">手机号</label>
            <div class="input-shell">
              <span class="phone-prefix" aria-hidden="true">+86</span>
              <input type="tel" id="phone" name="phone" required pattern="1[3-9][0-9]{9}" maxlength="11"
                placeholder="请输入手机号" autocomplete="tel-national" inputmode="numeric" />
            </div>
          </div>
          <div class="input-group">
            <label for="verificationCode">验证码</label>
            <div class="input-shell verification-group">
              <input type="text" id="verificationCode" name="verificationCode" required pattern="[0-9]{4}" maxlength="4"
                autocomplete="one-time-code" inputmode="numeric" placeholder="四位验证码" />
              <span class="verification-divider" aria-hidden="true"></span>
              <button type="button" id="getCodeBtn" disabled>获取验证码</button>
            </div>
          </div>
          <button type="submit" id="loginBtn" disabled>
            <span id="loginBtnLabel">登录</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" /></svg>
          </button>
          <p id="formStatus" class="form-status" role="status" aria-live="polite" aria-atomic="true"></p>
        </form>
      </section>
    </main>
    <script>
      const phoneInput = document.getElementById('phone')
      const verificationCodeInput = document.getElementById('verificationCode')
      const loginBtn = document.getElementById('loginBtn')
      const loginBtnLabel = document.getElementById('loginBtnLabel')
      const loginForm = document.getElementById('loginForm')
      const getCodeBtn = document.getElementById('getCodeBtn')
      const formStatus = document.getElementById('formStatus')
      const serverUrl = {{ server_url | tojson }}
      const sessionAuth = {{ auth | tojson }}
      const captchaId = '114d4e96cc4536050c7efaeb7e4f3c8c'

      // ===== 验证码请求反代（248 修复）=====
      // Windows 浏览器直连 alicaptcha 会因 HTTP User-Agent 平台标识被上游拒绝（248）。
      // 浏览器规范禁止 JS 修改 User-Agent，因此把所有发往 *.alicaptcha.com 的请求
      // 重写到插件同源的 /alicap/ 反代路由，由服务端注入 Android 画像后转发。
      // 两层覆盖：
      //   1. 页面内传输 hook（本块）——ct4.js 加载前同步安装，覆盖 fetch/XHR/
      //      script/img src/sendBeacon，SW 未就绪或不支持（非安全上下文）时也可用；
      //   2. Service Worker（下方注册）——接管后覆盖所有请求（含 CSS/Worker），
      //      且对后续加载生效。两层命中同一反代路由，行为一致。
      // 反代地址携带本次登录会话 auth：服务端只对仍然有效的会话转发，
      // 匿名访问不会产生任何上游流量。
      // 白名单与服务端 UPSTREAM_HOSTS 保持一致，避免两套边界漂移。
      const ALICAP_HOSTS = new Set([
        'captcha.alicaptcha.com',
        'captchabak.alicaptcha.com',
        'static.alicaptcha.com',
      ])
      const ALICAP_PROXY_PREFIX = serverUrl + '/alicap/' + sessionAuth + '/'

      function isAlicapUrl(value) {
        if (typeof value !== 'string' || !value) return false
        try { return ALICAP_HOSTS.has(new URL(value, location.href).hostname) } catch { return false }
      }
      function rewriteAlicapUrl(value) {
        const url = new URL(value, location.href)
        return ALICAP_PROXY_PREFIX + url.hostname + url.pathname + url.search
      }

      const nativeFetch = window.fetch
      if (nativeFetch) {
        window.fetch = function (input, init) {
          const url = typeof input === 'string' ? input : input && input.url
          if (typeof url === 'string' && isAlicapUrl(url)) {
            input = typeof input === 'string' ? rewriteAlicapUrl(url) : new Request(rewriteAlicapUrl(url), input)
          }
          return nativeFetch.call(this, input, init)
        }
      }
      const nativeXhrOpen = XMLHttpRequest.prototype.open
      XMLHttpRequest.prototype.open = function (method, url, ...rest) {
        return nativeXhrOpen.call(this, method, isAlicapUrl(url) ? rewriteAlicapUrl(url) : url, ...rest)
      }
      // 动态插入的脚本与图片通过 src 属性 setter 捕获。
      for (const [proto, name] of [[HTMLScriptElement, 'src'], [HTMLImageElement, 'src']]) {
        const descriptor = Object.getOwnPropertyDescriptor(proto.prototype, name)
        if (descriptor && descriptor.set) {
          Object.defineProperty(proto.prototype, name, {
            configurable: true,
            get: descriptor.get,
            set(value) {
              descriptor.set.call(this, isAlicapUrl(value) ? rewriteAlicapUrl(value) : value)
            },
          })
        }
      }
      if (navigator.sendBeacon) {
        const nativeSendBeacon = navigator.sendBeacon.bind(navigator)
        navigator.sendBeacon = function (url, data) {
          return nativeSendBeacon(isAlicapUrl(url) ? rewriteAlicapUrl(url) : url, data)
        }
      }

      // Service Worker 仅在安全上下文（https 或 localhost）可用；注册失败静默降级到页面内 hook。
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register(serverUrl + '/sw.js').catch(() => {})
      }
      let isSubmitting = false
      let isCodeCooldown = false
      let isSmsPending = false
      let isCaptchaLoading = false
      let captchaPromise = null

      function showMessage(message, kind = 'info') {
        formStatus.dataset.kind = kind
        formStatus.textContent = message
      }

      function updateLoginButton() {
        const isPhoneValid = /^1[3-9]\d{9}$/.test(phoneInput.value)
        const isCodeValid = /^\d{4}$/.test(verificationCodeInput.value)
        loginBtn.disabled = isSubmitting || !isPhoneValid || !isCodeValid
        getCodeBtn.disabled = isSubmitting || isCodeCooldown || isSmsPending || isCaptchaLoading || !isPhoneValid
      }
      phoneInput.addEventListener('input', updateLoginButton)
      verificationCodeInput.addEventListener('input', updateLoginButton)
      window.addEventListener('pageshow', updateLoginButton)

      function startCodeCooldown() {
        isCodeCooldown = true
        const deadline = Date.now() + 60000
        getCodeBtn.textContent = '60秒后重试'
        updateLoginButton()
        const timer = window.setInterval(() => {
          const remaining = Math.max(0, Math.ceil((deadline - Date.now()) / 1000))
          getCodeBtn.textContent = remaining ? `${remaining}秒后重试` : '获取验证码'
          if (!remaining) {
            window.clearInterval(timer)
            isCodeCooldown = false
            updateLoginButton()
          }
        }, 1000)
      }

      async function requestSmsCode(validation) {
        if (isSmsPending || isCodeCooldown) return
        isSmsPending = true
        getCodeBtn.textContent = '发送中…'
        updateLoginButton()
        try {
          const response = await fetch(`${serverUrl}/dna/getSmsCode`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              auth: sessionAuth,
              mobile: phoneInput.value,
              vJson: JSON.stringify({ ...validation, captcha_id: captchaId }),
            }),
          })
          if (!response.ok) throw new Error(`HTTP ${response.status}`)
          const result = await response.json()
          if (result.success) {
            showMessage('验证码已发送', 'success')
            startCodeCooldown()
          } else {
            showMessage('验证码发送失败' + (result.msg ? ': ' + result.msg : '，请重试'), 'error')
          }
        } catch {
          showMessage('验证码发送失败，请检查网络后重试', 'error')
        } finally {
          isSmsPending = false
          if (!isCodeCooldown) getCodeBtn.textContent = '获取验证码'
          updateLoginButton()
        }
      }

      // Load the verification SDK only on demand; it must not block the page or media.
      function loadCaptcha() {
        if (captchaPromise) return captchaPromise
        captchaPromise = new Promise((resolve, reject) => {
          const script = document.createElement('script')
          let settled = false
          function fail() {
            if (settled) return
            settled = true
            script.remove()
            reject(new Error('captcha unavailable'))
          }
          function initialize() {
            if (settled) return
            if (typeof window.initAlicom4 !== 'function') { fail(); return }
            try {
              window.initAlicom4({
                captchaId, https: true, product: 'bind', clientType: 'android',
                clientVersion: '1.8.4', outside: true, rem: 0.85,
                mi: {
                  packageName: 'com.dnabridge.dna_bridge', displayName: 'DNA登录桥',
                  appVer: '0.1.0', build: '1', clientVersion: '1.8.4',
                  geeid: { bd: '$unknown', d: '$unknown', e: '$unknown', ver: '1.0.0', client_type: 'android' },
                },
              }, function (captcha) {
                if (settled) return
                captcha
                  .onReady(function () {
                    if (settled) return
                    settled = true
                    resolve(captcha)
                  })
                  .onNextReady(function () {})
                  .onSuccess(function () {
                    const validation = captcha.getValidate()
                    if (validation) requestSmsCode(validation)
                    else showMessage('请完成验证', 'error')
                  })
                  .onFail(function () { showMessage('验证未通过，请重试', 'error') })
                  .onError(function (error) {
                    if (!settled) fail()
                    showMessage('验证失败' + (error?.msg ? ': ' + error.msg : '，请稍后重试'), 'error')
                  })
              })
            } catch { fail() }
          }
          if (typeof window.initAlicom4 === 'function') initialize()
          else {
            script.src = 'https://dnabbs.yingxiong.com/lib/ct4.js'
            script.async = true
            script.onload = initialize
            script.onerror = fail
            document.head.appendChild(script)
          }
        }).catch(error => {
          captchaPromise = null
          throw error
        })
        return captchaPromise
      }

      getCodeBtn.addEventListener('click', async function () {
        if (getCodeBtn.disabled) return
        isCaptchaLoading = true
        getCodeBtn.textContent = '加载验证…'
        showMessage('')
        updateLoginButton()
        try {
          const captcha = await loadCaptcha()
          captcha.showCaptcha()
        } catch {
          showMessage('安全验证未能加载，请检查网络后重试', 'error')
        } finally {
          isCaptchaLoading = false
          if (!isCodeCooldown && !isSmsPending) getCodeBtn.textContent = '获取验证码'
          updateLoginButton()
        }
      })

      loginForm.addEventListener('submit', async function (event) {
        event.preventDefault()
        if (loginBtn.disabled) return
        isSubmitting = true
        loginBtnLabel.textContent = '登录中…'
        loginForm.setAttribute('aria-busy', 'true')
        showMessage('')
        updateLoginButton()
        try {
          const response = await fetch(`${serverUrl}/dna/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ mobile: phoneInput.value, code: verificationCodeInput.value, auth: sessionAuth }),
          })
          if (!response.ok) throw new Error(`HTTP ${response.status}`)
          const result = await response.json()
          if (result.success) {
            showMessage('正在尝试登录…正在跳转…', 'success')
            window.setTimeout(() => { window.location.href = 'https://github.com/FlanChanXwO' }, 2000)
            return
          }
          showMessage('登录失败' + (result.msg ? ': ' + result.msg : '，请重试'), 'error')
        } catch {
          showMessage('登录失败，请检查网络后重试', 'error')
        }
        isSubmitting = false
        loginBtnLabel.textContent = '登录'
        loginForm.removeAttribute('aria-busy')
        updateLoginButton()
      })

      function initLoginMedia() {
        const video = document.getElementById('backgroundVideo')
        if (!video) return
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
        let videoFailed = false
        let pageHidden = document.hidden

        async function syncMedia() {
          const disabled = reducedMotion.matches || videoFailed
          if (disabled || pageHidden) {
            video.pause()
            if (disabled) {
              video.classList.remove('is-ready')
              // Releasing sources also stops downloads when reduced motion changes.
              if (video.hasAttribute('src')) {
                video.removeAttribute('src')
                video.load()
              }
            }
            return
          }
          if (!video.hasAttribute('src')) {
            video.muted = true
            video.src = video.dataset.videoSrc
          }
          try { await video.play() } catch { /* Keep the poster if autoplay fails. */ }
        }

        video.addEventListener('playing', function () {
          if (pageHidden || reducedMotion.matches || videoFailed) {
            video.pause()
            return
          }
          video.classList.add('is-ready')
        })
        video.addEventListener('error', function () {
          if (!video.hasAttribute('src')) return
          videoFailed = true
          syncMedia()
        })
        document.addEventListener('visibilitychange', function () {
          pageHidden = document.hidden
          syncMedia()
        })
        window.addEventListener('pagehide', function () { pageHidden = true; syncMedia() })
        window.addEventListener('pageshow', function () { pageHidden = document.hidden; syncMedia() })
        reducedMotion.addEventListener('change', syncMedia)
        syncMedia()
      }
      initLoginMedia()
    </script>
  </body>
</html>
