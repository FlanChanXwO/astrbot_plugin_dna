<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#141316" />
    <meta name="referrer" content="no-referrer" />
    <title>狩月终端 登录</title>
    <link rel="icon" href="{{ plugin_logo }}" type="image/png" />
    <style>
      :root {
        color-scheme: dark;
        --ink: #edeae2;
        --muted: #8c8982;
        --accent: #c4a062;
        --accent-light: #dfc48e;
        --surface: #202020;
        --input-bg: #272727;
        --border-color: #383838;
        --line: rgba(196, 160, 98, 0.22);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
        font-synthesis: none;
      }
      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      html, body { margin: 0; min-height: 100%; }
      body {
        min-height: 100vh;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        color: var(--ink);
        background: #18181a;
        isolation: isolate;
      }
      button, input { font: inherit; }
      button { cursor: pointer; touch-action: manipulation; }
      button:disabled { cursor: not-allowed; }
      button:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 4px;
      }
      .scene {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
        pointer-events: none;
        background: #242128 url('https://herobox-img.yingxiong.com/post/1748784746036602530.jpg') center / cover no-repeat;
      }
      .scene::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, rgba(12, 12, 16, 0.12) 35%, rgba(12, 12, 16, 0.58)),
          linear-gradient(0deg, rgba(12, 12, 16, 0.55), transparent 30%, transparent 80%, rgba(12, 12, 16, 0.35));
      }
      .background-video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: 50% 35%;
        opacity: 0;
        transition: opacity 240ms ease;
      }
      .background-video.is-ready { opacity: 1; }
      .site-header {
        width: 100%;
        max-width: 1600px;
        margin-inline: auto;
        padding: max(32px, env(safe-area-inset-top)) clamp(24px, 5vw, 80px) 0;
      }
      .brand { display: inline-flex; align-items: center; gap: 12px; }
      .brand img {
        display: block;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        border: 1px solid rgba(255, 255, 255, 0.3);
      }
      .logo-text {
        font-size: 18px;
        font-weight: 650;
        letter-spacing: 0.16em;
        text-shadow: 0 2px 12px #141316;
      }
      .login-container {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        width: 100%;
        max-width: 1600px;
        margin-inline: auto;
        padding: 48px clamp(24px, 5vw, 80px) 88px;
      }
      .form-panel {
        width: 408px;
        max-width: 100%;
        padding: 30px 32px 32px;
        background: #202020;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 14px;
        box-shadow: 0 24px 72px rgba(0, 0, 0, 0.55);
      }
      .form-toolbar {
        min-height: 44px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 2px;
      }
      .form-eyebrow {
        margin: 0;
        color: var(--accent);
        font-size: 13px;
        letter-spacing: 0.12em;
      }
      .media-controls { display: flex; gap: 8px; margin-right: -8px; }
      .media-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        padding: 0;
        color: var(--muted);
        background: transparent;
        border: 1px solid transparent;
        border-radius: 50%;
        transition: color 180ms ease, background-color 180ms ease;
      }
      .media-toggle:hover, .media-toggle:focus-visible {
        color: var(--ink);
        background: rgba(232, 207, 171, 0.09);
      }
      .media-toggle[aria-pressed='true'] { color: var(--accent); }
      .media-toggle svg { width: 19px; height: 19px; }
      .audio-toggle .sound-on, .motion-toggle .pause-icon { display: none; }
      .audio-toggle[aria-pressed='true'] .sound-on,
      .motion-toggle[aria-pressed='true'] .pause-icon { display: block; }
      .audio-toggle[aria-pressed='true'] .sound-off,
      .motion-toggle[aria-pressed='true'] .play-icon { display: none; }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
      h1 {
        margin: 4px 0 28px;
        font-size: clamp(24px, 2.1vw, 28px);
        font-weight: 600;
        line-height: 1.4;
        letter-spacing: 0.02em;
      }
      .input-group { margin-bottom: 20px; }
      label {
        display: block;
        margin-bottom: 9px;
        font-size: 13px;
        color: var(--muted);
      }
      .input-shell {
        display: flex;
        align-items: center;
        min-width: 0;
        min-height: 50px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        background: var(--input-bg);
        transition: border-color 180ms ease, background-color 180ms ease;
      }
      .input-shell:focus-within {
        border-color: var(--accent);
        background: #2c2c2c;
        box-shadow: 0 0 0 2px rgba(196, 160, 98, 0.2);
      }
      .phone-prefix {
        flex: none;
        margin-left: 16px;
        padding-right: 14px;
        border-right: 1px solid #3e3e3e;
        font-size: 14px;
        color: var(--muted);
      }
      input {
        width: 100%;
        min-width: 0;
        height: 48px;
        padding: 12px 14px;
        color: var(--ink);
        background: transparent;
        border: 0;
        border-radius: 8px;
        outline: none;
        font-size: 15px;
        line-height: 1.5;
      }
      input::placeholder { color: #787878; opacity: 1; }
      input:-webkit-autofill {
        -webkit-text-fill-color: var(--ink);
        box-shadow: 0 0 0 60px #272727 inset;
        caret-color: var(--ink);
      }
      #verificationCode { letter-spacing: 0.16em; }
      #verificationCode::placeholder { letter-spacing: 0; }
      .verification-divider {
        display: block;
        width: 1px;
        height: 18px;
        background: #424242;
        flex: none;
        margin: 0 4px;
      }
      #getCodeBtn {
        flex: none;
        min-width: 90px;
        min-height: 44px;
        padding: 0 14px;
        color: var(--accent-light);
        background: transparent;
        border: 0;
        border-radius: 0 8px 8px 0;
        font-size: 13px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        transition: color 180ms ease;
      }
      #getCodeBtn:hover:not(:disabled) { color: #ffffff; }
      #getCodeBtn:disabled { color: #787878; }
      #loginBtn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        width: 100%;
        min-height: 50px;
        margin-top: 26px;
        padding: 13px 18px;
        color: #17150f;
        background: linear-gradient(135deg, var(--accent-light), var(--accent));
        border: 0;
        border-radius: 8px;
        font-size: 15px;
        font-weight: 650;
        letter-spacing: 0.12em;
        box-shadow: 0 8px 20px rgba(196, 160, 98, 0.25);
        transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
      }
      #loginBtn svg { width: 18px; height: 18px; }
      #loginBtn:hover:not(:disabled) { background: #f4e0c4; transform: translateY(-1px); }
      #loginBtn:active:not(:disabled) { background: var(--accent); transform: translateY(0); }
      #loginBtn:disabled {
        color: #787878;
        background: #373737;
        box-shadow: none;
        border: 0;
        cursor: not-allowed;
      }
      .form-status {
        margin: 16px 0 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.65;
        overflow-wrap: anywhere;
      }
      .form-status:empty { display: none; }
      .form-status[data-kind='error'] { color: #ffb4b9; }
      .form-status[data-kind='success'] { color: #d7e7bd; }
      @media (max-width: 720px) {
        .scene {
          bottom: auto;
          height: 70vh;
          height: 70svh;
          min-height: 400px;
          background-position: 52% 20%;
        }
        .background-video { object-position: 52% 20%; }
        .scene::after {
          background: linear-gradient(180deg, rgba(20, 19, 22, 0.22), transparent 22%, transparent 53%, #141316 100%);
        }
        .site-header {
          padding: max(20px, env(safe-area-inset-top)) max(22px, env(safe-area-inset-left)) 0;
        }
        .brand { gap: 10px; }
        .brand img { width: 34px; height: 34px; border-radius: 10px; }
        .logo-text { font-size: 16px; }
        .login-container {
          flex: 1;
          align-items: flex-end;
          justify-content: center;
          padding: clamp(210px, 35svh, 420px) max(16px, env(safe-area-inset-right)) max(24px, env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));
        }
        .form-panel { width: 408px; padding: 18px 24px 24px; border-radius: 18px; }
        h1 { margin-bottom: 24px; font-size: 25px; }
        .input-group { margin-bottom: 18px; }
        #loginBtn { margin-top: 24px; }
      }
      @media (max-width: 720px) and (max-height: 740px) {
        .login-container { padding-top: clamp(155px, 28svh, 210px); padding-bottom: max(16px, env(safe-area-inset-bottom)); }
      }
      @media (max-width: 360px) {
        .form-panel { padding-inline: 20px; }
        h1 { font-size: 23px; }
        #getCodeBtn { min-width: 80px; padding-inline: 8px; }
      }
      @media (max-height: 520px) and (min-width: 721px) {
        .site-header { padding-top: max(20px, env(safe-area-inset-top)); }
        .login-container { padding-block: 24px; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { transition: none !important; scroll-behavior: auto !important; }
      }
    </style>
  </head>
  <body>
    <div class="scene" aria-hidden="true">
      {% if login_media and login_media.video_url and login_media.audio_url %}
      <video id="backgroundVideo" class="background-video" loop muted playsinline preload="none"
        disablepictureinpicture data-video-src="{{ login_media.video_url | e }}"></video>
      {% endif %}
    </div>
    {% if login_media and login_media.video_url and login_media.audio_url %}
    <audio id="backgroundAudio" loop preload="none" data-audio-src="{{ login_media.audio_url | e }}"></audio>
    {% endif %}
    <header class="site-header">
      <div class="brand">
        <img src="{{ plugin_logo }}" alt="狩月终端 Logo" width="40" height="40" />
        <div class="logo-text">狩月终端</div>
      </div>
    </header>
    <main class="login-container">
      <section class="form-panel" aria-labelledby="loginHeading">
        <form id="loginForm">
          <div class="form-toolbar">
            <p class="form-eyebrow">皎皎角账号</p>
            {% if login_media and login_media.video_url and login_media.audio_url %}
            <div class="media-controls" role="group" aria-label="背景播放控制">
              <button type="button" id="motionToggle" class="media-toggle motion-toggle" hidden
                aria-label="暂停动态背景" title="暂停动态背景" aria-pressed="false">
                <svg class="pause-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M8 5v14M16 5v14" /></svg>
                <svg class="play-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="m8 5 11 7-11 7Z" /></svg>
              </button>
              <button type="button" id="audioToggle" class="media-toggle audio-toggle" hidden
                aria-label="开启音乐" title="开启音乐" aria-pressed="false">
                <svg class="sound-on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m11 4-6 5H2v6h3l6 5ZM15 8a6 6 0 0 1 0 8M18 5a10 10 0 0 1 0 14" /></svg>
                <svg class="sound-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m11 4-6 5H2v6h3l6 5ZM16 9l6 6m0-6-6 6" /></svg>
                <span id="audioToggleLabel" class="sr-only">开启音乐</span>
              </button>
            </div>
            {% endif %}
          </div>
          <h1 id="loginHeading">登录狩月终端</h1>
          <div class="input-group">
            <label for="phone">手机号</label>
            <div class="input-shell">
              <span class="phone-prefix" aria-hidden="true">+86</span>
              <input type="tel" id="phone" name="phone" required pattern="1[3-9][0-9]{9}" maxlength="11"
                placeholder="请输入手机号" autocomplete="tel-national" inputmode="numeric" />
            </div>
          </div>
          <div class="input-group">
            <label for="verificationCode">验证码</label>
            <div class="input-shell verification-group">
              <input type="text" id="verificationCode" name="verificationCode" required pattern="[0-9]{4}" maxlength="4"
                autocomplete="one-time-code" inputmode="numeric" placeholder="四位验证码" />
              <span class="verification-divider" aria-hidden="true"></span>
              <button type="button" id="getCodeBtn" disabled>获取验证码</button>
            </div>
          </div>
          <button type="submit" id="loginBtn" disabled>
            <span id="loginBtnLabel">登录</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" /></svg>
          </button>
          <p id="formStatus" class="form-status" role="status" aria-live="polite" aria-atomic="true"></p>
        </form>
      </section>
    </main>
    <script>
      const phoneInput = document.getElementById('phone')
      const verificationCodeInput = document.getElementById('verificationCode')
      const loginBtn = document.getElementById('loginBtn')
      const loginBtnLabel = document.getElementById('loginBtnLabel')
      const loginForm = document.getElementById('loginForm')
      const getCodeBtn = document.getElementById('getCodeBtn')
      const formStatus = document.getElementById('formStatus')
      const serverUrl = {{ server_url | tojson }}
      const sessionAuth = {{ auth | tojson }}
      const captchaId = '114d4e96cc4536050c7efaeb7e4f3c8c'
      let isSubmitting = false
      let isCodeCooldown = false
      let isSmsPending = false
      let isCaptchaLoading = false
      let captchaPromise = null

      function showMessage(message, kind = 'info') {
        formStatus.dataset.kind = kind
        formStatus.textContent = message
      }

      function updateLoginButton() {
        const isPhoneValid = /^1[3-9]\d{9}$/.test(phoneInput.value)
        const isCodeValid = /^\d{4}$/.test(verificationCodeInput.value)
        loginBtn.disabled = isSubmitting || !isPhoneValid || !isCodeValid
        getCodeBtn.disabled = isSubmitting || isCodeCooldown || isSmsPending || isCaptchaLoading || !isPhoneValid
      }
      phoneInput.addEventListener('input', updateLoginButton)
      verificationCodeInput.addEventListener('input', updateLoginButton)
      window.addEventListener('pageshow', updateLoginButton)

      function startCodeCooldown() {
        isCodeCooldown = true
        const deadline = Date.now() + 60000
        getCodeBtn.textContent = '60秒后重试'
        updateLoginButton()
        const timer = window.setInterval(() => {
          const remaining = Math.max(0, Math.ceil((deadline - Date.now()) / 1000))
          getCodeBtn.textContent = remaining ? `${remaining}秒后重试` : '获取验证码'
          if (!remaining) {
            window.clearInterval(timer)
            isCodeCooldown = false
            updateLoginButton()
          }
        }, 1000)
      }

      async function requestSmsCode(validation) {
        if (isSmsPending || isCodeCooldown) return
        isSmsPending = true
        getCodeBtn.textContent = '发送中…'
        updateLoginButton()
        try {
          const response = await fetch(`${serverUrl}/dna/getSmsCode`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              auth: sessionAuth,
              mobile: phoneInput.value,
              vJson: JSON.stringify({ ...validation, captcha_id: captchaId }),
            }),
          })
          if (!response.ok) throw new Error(`HTTP ${response.status}`)
          const result = await response.json()
          if (result.success) {
            showMessage('验证码已发送', 'success')
            startCodeCooldown()
          } else {
            showMessage('验证码发送失败' + (result.msg ? ': ' + result.msg : '，请重试'), 'error')
          }
        } catch {
          showMessage('验证码发送失败，请检查网络后重试', 'error')
        } finally {
          isSmsPending = false
          if (!isCodeCooldown) getCodeBtn.textContent = '获取验证码'
          updateLoginButton()
        }
      }

      // Load the verification SDK only on demand; it must not block the page or media.
      function loadCaptcha() {
        if (captchaPromise) return captchaPromise
        captchaPromise = new Promise((resolve, reject) => {
          const script = document.createElement('script')
          let settled = false
          const timer = window.setTimeout(() => fail(), 15000)
          function fail() {
            if (settled) return
            settled = true
            window.clearTimeout(timer)
            script.remove()
            reject(new Error('captcha unavailable'))
          }
          function initialize() {
            if (settled) return
            if (typeof window.initAlicom4 !== 'function') { fail(); return }
            try {
              window.initAlicom4({
                captchaId, https: true, product: 'bind', clientType: 'android',
                clientVersion: '1.8.4', outside: true, rem: 0.85,
                mi: {
                  packageName: 'com.dnabridge.dna_bridge', displayName: 'DNA登录桥',
                  appVer: '0.1.0', build: '1', clientVersion: '1.8.4',
                  geeid: { bd: '$unknown', d: '$unknown', e: '$unknown', ver: '1.0.0', client_type: 'android' },
                },
              }, function (captcha) {
                if (settled) return
                captcha
                  .onReady(function () {
                    if (settled) return
                    settled = true
                    window.clearTimeout(timer)
                    resolve(captcha)
                  })
                  .onNextReady(function () {})
                  .onSuccess(function () {
                    const validation = captcha.getValidate()
                    if (validation) requestSmsCode(validation)
                    else showMessage('请完成验证', 'error')
                  })
                  .onFail(function () { showMessage('验证未通过，请重试', 'error') })
                  .onError(function (error) {
                    if (!settled) fail()
                    showMessage('验证失败' + (error?.msg ? ': ' + error.msg : '，请稍后重试'), 'error')
                  })
              })
            } catch { fail() }
          }
          if (typeof window.initAlicom4 === 'function') initialize()
          else {
            script.src = 'https://dnabbs.yingxiong.com/lib/ct4.js'
            script.async = true
            script.onload = initialize
            script.onerror = fail
            document.head.appendChild(script)
          }
        }).catch(error => {
          captchaPromise = null
          throw error
        })
        return captchaPromise
      }

      getCodeBtn.addEventListener('click', async function () {
        if (getCodeBtn.disabled) return
        isCaptchaLoading = true
        getCodeBtn.textContent = '加载验证…'
        showMessage('')
        updateLoginButton()
        try {
          const captcha = await loadCaptcha()
          captcha.showCaptcha()
        } catch {
          showMessage('安全验证未能加载，请检查网络后重试', 'error')
        } finally {
          isCaptchaLoading = false
          if (!isCodeCooldown && !isSmsPending) getCodeBtn.textContent = '获取验证码'
          updateLoginButton()
        }
      })

      loginForm.addEventListener('submit', async function (event) {
        event.preventDefault()
        if (loginBtn.disabled) return
        isSubmitting = true
        loginBtnLabel.textContent = '登录中…'
        loginForm.setAttribute('aria-busy', 'true')
        showMessage('')
        updateLoginButton()
        try {
          const response = await fetch(`${serverUrl}/dna/login`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ mobile: phoneInput.value, code: verificationCodeInput.value, auth: sessionAuth }),
          })
          if (!response.ok) throw new Error(`HTTP ${response.status}`)
          const result = await response.json()
          if (result.success) {
            showMessage('正在尝试登录…正在跳转…', 'success')
            window.setTimeout(() => { window.location.href = 'https://github.com/FlanChanXwO' }, 2000)
            return
          }
          showMessage('登录失败' + (result.msg ? ': ' + result.msg : '，请重试'), 'error')
        } catch {
          showMessage('登录失败，请检查网络后重试', 'error')
        }
        isSubmitting = false
        loginBtnLabel.textContent = '登录'
        loginForm.removeAttribute('aria-busy')
        updateLoginButton()
      })

      function initLoginMedia() {
        const video = document.getElementById('backgroundVideo')
        const audio = document.getElementById('backgroundAudio')
        const audioToggle = document.getElementById('audioToggle')
        const audioLabel = document.getElementById('audioToggleLabel')
        const motionToggle = document.getElementById('motionToggle')
        if (!video || !audio || !audioToggle || !motionToggle) return
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
        let videoWanted = true
        let audioWanted = false
        let videoFailed = false
        let audioFailed = false
        let pageHidden = document.hidden

        function updateControls() {
          const playing = !audio.paused && !audio.muted
          const audioText = playing ? '静音' : '开启音乐'
          audioToggle.setAttribute('aria-pressed', String(playing))
          audioToggle.setAttribute('aria-label', audioText)
          audioToggle.title = audioText
          audioLabel.textContent = audioText
          const moving = !video.paused
          const motionText = moving ? '暂停动态背景' : '播放动态背景'
          motionToggle.setAttribute('aria-pressed', String(moving))
          motionToggle.setAttribute('aria-label', motionText)
          motionToggle.title = motionText
        }

        async function syncMedia() {
          const disabled = reducedMotion.matches || videoFailed
          motionToggle.hidden = disabled
          audioToggle.hidden = disabled || audioFailed
          if (disabled || pageHidden) {
            video.pause()
            audio.pause()
            if (disabled) {
              video.classList.remove('is-ready')
              // Releasing sources also stops downloads when reduced motion changes.
              for (const media of [video, audio]) {
                if (media.hasAttribute('src')) {
                  media.removeAttribute('src')
                  media.load()
                }
              }
            }
            updateControls()
            return
          }
          if (!video.hasAttribute('src')) {
            video.muted = true
            video.src = video.dataset.videoSrc
          }
          if (videoWanted) {
            try { await video.play() } catch { /* Keep the poster and manual play control. */ }
          } else video.pause()
          // A user gesture is required before loading the separate soundtrack.
          if (audioWanted && !audioFailed && !pageHidden && !reducedMotion.matches && !videoFailed) {
            if (!audio.hasAttribute('src')) audio.src = audio.dataset.audioSrc
            audio.volume = 0.35
            try { await audio.play() } catch { audioWanted = false }
          } else audio.pause()
          updateControls()
        }

        video.addEventListener('playing', function () {
          if (pageHidden || reducedMotion.matches || videoFailed || !videoWanted) {
            video.pause()
            return
          }
          video.classList.add('is-ready')
          updateControls()
        })
        video.addEventListener('pause', updateControls)
        video.addEventListener('error', function () {
          if (!video.hasAttribute('src')) return
          videoFailed = true
          audioWanted = false
          syncMedia()
        })
        audio.addEventListener('playing', function () {
          if (pageHidden || reducedMotion.matches || !audioWanted) audio.pause()
          updateControls()
        })
        audio.addEventListener('pause', updateControls)
        audio.addEventListener('error', function () {
          if (!audio.hasAttribute('src')) return
          audioFailed = true
          audioWanted = false
          audioToggle.hidden = true
          audio.pause()
        })
        audioToggle.addEventListener('click', async function () {
          audioWanted = !audioWanted
          // Start directly in the gesture, before awaiting the video play promise.
          if (audioWanted) {
            if (!audio.hasAttribute('src')) audio.src = audio.dataset.audioSrc
            audio.volume = 0.35
            try { await audio.play() } catch { audioWanted = false }
          } else audio.pause()
          updateControls()
        })
        motionToggle.addEventListener('click', function () {
          videoWanted = !video.paused ? false : true
          syncMedia()
        })
        document.addEventListener('visibilitychange', function () {
          pageHidden = document.hidden
          syncMedia()
        })
        window.addEventListener('pagehide', function () { pageHidden = true; syncMedia() })
        window.addEventListener('pageshow', function () { pageHidden = document.hidden; syncMedia() })
        reducedMotion.addEventListener('change', syncMedia)
        syncMedia()
      }
      initLoginMedia()
    </script>
  </body>
</html>
