[
  {
    "id": "help",
    "pattern": "^帮助$",
    "group": "bot主人功能",
    "name": "帮助",
    "description": "查看当前已实现命令",
    "examples": [
      "帮助"
    ],
    "permission": "user",
    "use_case": "src.modules.help.help_use_case"
  },
  {
    "id": "account_login",
    "pattern": "^(?:(?:dna|DNA)?(?:登录|登陆|登入|登龙)|login)\\s*(?P<arg>.*)$",
    "group": "皎皎角登录",
    "name": "登录",
    "description": "皎皎角登录（登录页/短信验证码/token）",
    "examples": [
      "登录",
      "登录tttttttttttttttttttttttttttttttttttttttt"
    ],
    "permission": "user",
    "use_case": "src.modules.account.commands.account_login_use_case"
  },
  {
    "id": "account_logout",
    "pattern": "^(?:退出登录|登出|logout)$",
    "group": "皎皎角登录",
    "name": "退出登录",
    "description": "退出当前登录",
    "examples": [
      "退出登录"
    ],
    "permission": "user",
    "use_case": "src.modules.account.commands.account_logout_use_case"
  },
  {
    "id": "account_bind",
    "pattern": "^绑定\\s*(?P<uid>\\S+)$",
    "group": "绑定账号",
    "name": "绑定UID",
    "description": "绑定一个 UID",
    "examples": [
      "绑定1234567890123"
    ],
    "permission": "user",
    "use_case": "src.modules.account.commands.account_bind_use_case"
  },
  {
    "id": "account_switch",
    "pattern": "^切换\\s*(?P<uid>\\S+)$",
    "group": "绑定账号",
    "name": "切换UID",
    "description": "切换当前 UID",
    "examples": [
      "切换1234567890123"
    ],
    "permission": "user",
    "use_case": "src.modules.account.commands.account_switch_use_case"
  },
  {
    "id": "account_delete_all",
    "pattern": "^删除全部(?:UID|uid)?$",
    "group": "绑定账号",
    "name": "删除全部UID",
    "description": "删除当前作用域的全部 UID",
    "examples": [
      "删除全部UID"
    ],
    "permission": "user",
    "use_case": "src.modules.account.commands.account_delete_all_use_case"
  },
  {
    "id": "account_delete",
    "pattern": "^删除\\s*(?P<uid>(?!全部(?:UID|uid)?$)\\S+)$",
    "group": "绑定账号",
    "name": "删除UID",
    "description": "删除一个 UID",
    "examples": [
      "删除1234567890123"
    ],
    "permission": "user",
    "use_case": "src.modules.account.commands.account_delete_use_case"
  },
  {
    "id": "account_list",
    "pattern": "^查看(?:UID|uid)?$",
    "group": "绑定账号",
    "name": "查看UID",
    "description": "查看当前绑定 UID",
    "examples": [
      "查看UID"
    ],
    "permission": "user",
    "use_case": "src.modules.account.commands.account_list_use_case"
  },
  {
    "id": "account_credentials",
    "pattern": "^(?:获取ck|获取CK|获取Token|获取token|获取TOKEN)$",
    "group": "绑定账号",
    "name": "获取凭据状态",
    "description": "查看当前绑定账号的凭据状态（严格脱敏）",
    "examples": [
      "获取ck"
    ],
    "permission": "user",
    "use_case": "src.modules.account.commands.account_credentials_use_case"
  },
  {
    "id": "privacy_enable_peek_personal",
    "pattern": "^(?:开偷窥|关闭偷窥防护)$",
    "group": "隐私控制",
    "name": "开偷窥",
    "description": "允许被其它人查看自己的游戏信息",
    "examples": [
      "开偷窥"
    ],
    "permission": "user",
    "use_case": "src.modules.privacy.commands.privacy_enable_peek_personal_use_case"
  },
  {
    "id": "privacy_disable_peek_personal",
    "pattern": "^(?:防偷窥|开启偷窥防护)$",
    "group": "隐私控制",
    "name": "防偷窥",
    "description": "禁止被其它人查看自己的游戏信息",
    "examples": [
      "防偷窥"
    ],
    "permission": "user",
    "use_case": "src.modules.privacy.commands.privacy_disable_peek_personal_use_case"
  },
  {
    "id": "privacy_enable_uid_hidden",
    "pattern": "^(?:隐藏UID|隐藏uid)$",
    "group": "隐私控制",
    "name": "隐藏UID",
    "description": "在生成的卡片中隐藏自己的UID",
    "examples": [
      "隐藏UID"
    ],
    "permission": "user",
    "use_case": "src.modules.privacy.commands.privacy_enable_uid_hidden_use_case"
  },
  {
    "id": "privacy_disable_uid_hidden",
    "pattern": "^(?:显示UID|显示uid)$",
    "group": "隐私控制",
    "name": "显示UID",
    "description": "在生成的卡片中显示自己的UID",
    "examples": [
      "显示UID"
    ],
    "permission": "user",
    "use_case": "src.modules.privacy.commands.privacy_disable_uid_hidden_use_case"
  },
  {
    "id": "privacy_enable_peek_admin",
    "pattern": "^指定开偷窥$",
    "group": "群管理员功能",
    "name": "指定开偷窥",
    "description": "允许会话中被艾特的玩家被其它人查看该玩家的游戏信息",
    "examples": [
      "指定开偷窥"
    ],
    "permission": "admin",
    "use_case": "src.modules.privacy.commands.privacy_enable_peek_admin_use_case"
  },
  {
    "id": "privacy_disable_peek_admin",
    "pattern": "^指定防偷窥$",
    "group": "群管理员功能",
    "name": "指定防偷窥",
    "description": "禁止会话中被艾特的玩家被其它人查看该玩家的游戏信息",
    "examples": [
      "指定防偷窥"
    ],
    "permission": "admin",
    "use_case": "src.modules.privacy.commands.privacy_disable_peek_admin_use_case"
  },
  {
    "id": "privacy_enable_peek_all",
    "pattern": "^全体开偷窥$",
    "group": "群管理员功能",
    "name": "全体开偷窥",
    "description": "允许会话中所有玩家相互查看自己的游戏信息",
    "examples": [
      "全体开偷窥"
    ],
    "permission": "admin",
    "use_case": "src.modules.privacy.commands.privacy_enable_peek_all_use_case"
  },
  {
    "id": "privacy_disable_peek_all",
    "pattern": "^全体防偷窥$",
    "group": "群管理员功能",
    "name": "全体防偷窥",
    "description": "禁止会话中所有玩家相互查看自己的游戏信息",
    "examples": [
      "全体防偷窥"
    ],
    "permission": "admin",
    "use_case": "src.modules.privacy.commands.privacy_disable_peek_all_use_case"
  },
  {
    "id": "privacy_cancel_peek_all",
    "pattern": "^取消全体偷窥$",
    "group": "群管理员功能",
    "name": "取消全体偷窥",
    "description": "取消全体偷窥设置，恢复个人设置",
    "examples": [
      "取消全体偷窥"
    ],
    "permission": "admin",
    "use_case": "src.modules.privacy.commands.privacy_cancel_peek_all_use_case"
  },
  {
    "id": "privacy_enable_uid_hidden_admin",
    "pattern": "^指定隐藏UID$",
    "group": "群管理员功能",
    "name": "指定隐藏UID",
    "description": "为会话中被艾特的玩家开启UID隐藏",
    "examples": [
      "指定隐藏UID"
    ],
    "permission": "admin",
    "use_case": "src.modules.privacy.commands.privacy_enable_uid_hidden_admin_use_case"
  },
  {
    "id": "privacy_disable_uid_hidden_admin",
    "pattern": "^指定显示UID$",
    "group": "群管理员功能",
    "name": "指定显示UID",
    "description": "为会话中被艾特的玩家关闭UID隐藏",
    "examples": [
      "指定显示UID"
    ],
    "permission": "admin",
    "use_case": "src.modules.privacy.commands.privacy_disable_uid_hidden_admin_use_case"
  },
  {
    "id": "privacy_enable_uid_hidden_all",
    "pattern": "^全体隐藏UID$",
    "group": "群管理员功能",
    "name": "全体隐藏UID",
    "description": "强制会话中所有玩家隐藏UID",
    "examples": [
      "全体隐藏UID"
    ],
    "permission": "admin",
    "use_case": "src.modules.privacy.commands.privacy_enable_uid_hidden_all_use_case"
  },
  {
    "id": "privacy_disable_uid_hidden_all",
    "pattern": "^全体显示UID$",
    "group": "群管理员功能",
    "name": "全体显示UID",
    "description": "强制会话中所有玩家显示UID",
    "examples": [
      "全体显示UID"
    ],
    "permission": "admin",
    "use_case": "src.modules.privacy.commands.privacy_disable_uid_hidden_all_use_case"
  },
  {
    "id": "privacy_cancel_uid_hidden_all",
    "pattern": "^取消全体UID隐藏$",
    "group": "群管理员功能",
    "name": "取消全体UID隐藏",
    "description": "取消全体UID隐藏设置，恢复个人设置",
    "examples": [
      "取消全体UID隐藏"
    ],
    "permission": "admin",
    "use_case": "src.modules.privacy.commands.privacy_cancel_uid_hidden_all_use_case"
  }
]
