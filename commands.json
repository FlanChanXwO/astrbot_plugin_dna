    "permission": "user",
    "use_case": "src.modules.account.commands.account_delete_all_use_case"
  },
  {
    "id": "account_delete",
    "pattern": "^dna删除\\s*(?P<uid>(?!全部(?:UID|uid)?$)\\d*)$",
