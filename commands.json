[
  {
    "id": "help",
    "pattern": "^帮助$",
    "group": "bot主人功能",
    "name": "帮助",
    "description": "查看当前已实现命令",
    "examples": [
      "帮助"
    ],
    "permission": "user",
    "use_case": "src.modules.help.help_use_case"
  },
  {
    "id": "account_login",
    "pattern": "^(?:(?:dna|DNA)?(?:登录|登陆|登入|登龙)|login)\\s*(?P<arg>.*)$",
    "group": "皎皎角登录",
    "name": "登录",
    "description": "皎皎角登录（登录页/短信验证码/token）",
    "examples": [
      "登录",
      "登录tttttttttttttttttttttttttttttttttttttttt"
    ],
    "permission": "user",
    "use_case": "src.modules.account.commands.account_login_use_case"
  },
  {
    "id": "account_logout",
    "pattern": "^(?:退出登录|登出|logout)$",
    "group": "皎皎角登录",
    "name": "退出登录",
    "description": "退出当前登录",
    "examples": [
      "退出登录"
    ],
    "permission": "user",
    "use_case": "src.modules.account.commands.account_logout_use_case"
  },
  {
    "id": "account_bind",
    "pattern": "^绑定\\s*(?P<uid>\\S+)$",
    "group": "绑定账号",
    "name": "绑定UID",
    "description": "绑定一个 UID",
    "examples": [
      "绑定1234567890123"
    ],
    "permission": "user",
    "use_case": "src.modules.account.commands.account_bind_use_case"
  },
  {
    "id": "account_switch",
    "pattern": "^切换\\s*(?P<uid>\\S+)$",
    "group": "绑定账号",
    "name": "切换UID",
    "description": "切换当前 UID",
    "examples": [
      "切换1234567890123"
    ],
    "permission": "user",
    "use_case": "src.modules.account.commands.account_switch_use_case"
  },
  {
    "id": "account_delete_all",
    "pattern": "^删除全部(?:UID|uid)?$",
    "group": "绑定账号",
    "name": "删除全部UID",
    "description": "删除当前作用域的全部 UID",
    "examples": [
      "删除全部UID"
    ],
    "permission": "user",
    "use_case": "src.modules.account.commands.account_delete_all_use_case"
  },
  {
    "id": "account_delete",
    "pattern": "^删除\\s*(?P<uid>(?!全部(?:UID|uid)?$)\\S+)$",
    "group": "绑定账号",
    "name": "删除UID",
    "description": "删除一个 UID",
    "examples": [
      "删除1234567890123"
    ],
    "permission": "user",
    "use_case": "src.modules.account.commands.account_delete_use_case"
  },
  {
    "id": "account_list",
    "pattern": "^查看(?:UID|uid)?$",
    "group": "绑定账号",
    "name": "查看UID",
    "description": "查看当前绑定 UID",
    "examples": [
      "查看UID"
    ],
    "permission": "user",
    "use_case": "src.modules.account.commands.account_list_use_case"
  },
  {
    "id": "account_credentials",
    "pattern": "^(?:获取ck|获取CK|获取Token|获取token|获取TOKEN)$",
    "group": "绑定账号",
    "name": "获取凭据状态",
    "description": "查看当前绑定账号的凭据状态（严格脱敏）",
    "examples": [
      "获取ck"
    ],
    "permission": "user",
    "use_case": "src.modules.account.commands.account_credentials_use_case"
  }
]
