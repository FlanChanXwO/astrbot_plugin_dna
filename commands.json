[
  {
    "id": "help",
    "pattern": "^dna帮助$",
    "group": "信息查询",
    "name": "帮助",
    "description": "查看当前已实现命令",
    "examples": [
      "dna帮助"
    ],
    "permission": "user",
    "use_case": "src.modules.help.help_use_case"
  },
  {
    "id": "account_token_login",
    "pattern": "^dna(?:token登录|登录token)\\s*(?P<arg>.*)$",
    "group": "账号管理",
    "name": "token登录",
    "description": "使用 App token 登录，不输出原始凭据",
    "examples": [
      "dnatoken登录<token>"
    ],
    "permission": "user",
    "use_case": "src.modules.account.commands.account_token_login_use_case"
  },
  {
    "id": "account_login",
    "pattern": "^dna(?:登录|登陆|登入|登龙|login)\\s*(?P<arg>.*)$",
    "group": "账号管理",
    "name": "登录",
    "description": "皎皎角登录（登录页/短信验证码/token）",
    "examples": [
      "dna登录",
      "dna登录<token>"
    ],
    "permission": "user",
    "use_case": "src.modules.account.commands.account_login_use_case"
  },
  {
    "id": "account_logout",
    "pattern": "^dna(?:退出登录|登出|logout)$",
    "group": "账号管理",
    "name": "退出登录",
    "description": "退出当前登录",
    "examples": [
      "dna退出登录"
    ],
    "permission": "user",
    "use_case": "src.modules.account.commands.account_logout_use_case"
  },
  {
    "id": "account_switch",
    "pattern": "^dna切换\\s*(?P<uid>\\S*)$",
    "group": "账号管理",
    "name": "切换UID",
    "description": "切换当前 UID",
    "examples": [
