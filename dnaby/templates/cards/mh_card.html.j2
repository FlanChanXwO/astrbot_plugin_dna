{% from "cards/macros/layout.html.j2" import card_shell %}
{% call card_shell(width, height, background=background, class_name="mh-card") %}
<style>
  @font-face { font-family: "DNAUnicode"; src: url("{{ font }}") format("woff2"); }
  .mh-card .dna-card__content { position: relative; height: 100%; font-family: "DNAUnicode", sans-serif; }
  .mh-card__entry { position: absolute; top: 70px; width: 511px; height: 776px; color: #fff; text-align: center; }
  .mh-card__entry:nth-of-type(1) { left: 100px; }.mh-card__entry:nth-of-type(2) { left: 600px; }.mh-card__entry:nth-of-type(3) { left: 1100px; }
  .mh-card__entry-bg { position: absolute; inset: 0; width: 511px; height: 776px; }
  .mh-card__icon { position: absolute; top: 70px; left: 120px; width: 256px; height: 256px; object-fit: contain; }
  .mh-card__type { position: absolute; top: 326px; right: 0; left: 0; margin: 0; color: #daa520; font-size: 40px; font-weight: 400; line-height: 48px; }
  .mh-card__state { position: absolute; top: 386px; right: 0; left: 0; margin: 0; color: #e6e6e6; font-size: 20px; font-weight: 400; line-height: 28px; }
  .mh-card__instance { position: relative; z-index: 1; width: 374px; height: 55px; margin: 0 0 25px; padding: 0; color: #fff; font-size: 36px; line-height: 55px; overflow: hidden; }
  .mh-card__instance-wrap { position: absolute; top: 420px; left: 70px; display: flex; flex-direction: column; gap: 25px; align-items: center; }
  .mh-card__instance-wrap li { position: relative; list-style: none; }.mh-card__instance-wrap li::before { position: absolute; inset: 0; z-index: -1; display: block; width: 374px; height: 55px; background: url("{{ bar }}") center/374px 55px no-repeat; content: ""; }
  .mh-card__instance.subscribed { color: #4caf50; }
  .mh-card__refresh { position: absolute; top: 20px; left: 1400px; width: 317px; height: 76px; margin: 0; padding: 22px 0 0 60px; background: url("{{ refresh_background }}") center/317px 76px no-repeat; color: #fff; font-size: 20px; }
  .mh-card__title { position: absolute; top: 0; left: 0; width: 376px; height: 108px; }
  .mh-card__footer { position: absolute; bottom: 20px; left: 550px; width: 600px; height: 23px; object-fit: contain; }
</style>
{% for card in cards %}<article class="mh-card__entry"><img class="mh-card__entry-bg" src="{{ card_background }}" alt="" />{% if card.icon %}<img class="mh-card__icon" src="{{ card.icon }}" alt="" />{% endif %}<h1 class="mh-card__type">{{ card.type_name }}</h1><p class="mh-card__state">当前开放</p><ul class="mh-card__instance-wrap">{% for instance in card.instances %}<li class="mh-card__instance{% if instance.subscribed %} subscribed{% endif %}">{{ instance.name }}</li>{% endfor %}</ul></article>{% endfor %}
<img class="mh-card__title" src="{{ title }}" alt="" />
<img class="mh-card__footer" src="{{ footer }}" alt="" />
<p class="mh-card__refresh">{{ refresh_text }}</p>
{% endcall %}
