{% from "cards/macros/layout.html.j2" import card_shell %}
{% call card_shell(width, height, background=background, class_name="announcement-list") %}
<style>
  @font-face { font-family: "DNAUnicode"; src: url("{{ font }}") format("woff2"); }
  {% if font_fallback %}@font-face { font-family: "DNAUnicodeFallback"; src: url("{{ font_fallback }}") format("woff2"); }{% endif %}
  .announcement-list { position: relative; width: 1080px; height: {{ height }}px; font-family: "DNAUnicode", "DNAUnicodeFallback", sans-serif; }
  .announcement-list__header { position: absolute; top: 0; left: 0; width: 1080px; height: 168px; background: rgba(10, 8, 20, .31); }
  .announcement-list__header::before { position: absolute; top: 52px; left: 28px; width: 8px; height: 64px; border-radius: 4px; background: #b22222; content: ""; }
  .announcement-list__header h1 { position: absolute; top: 84px; left: 40px; margin: 0; color: #eee8aa; font-size: 60px; font-weight: 700; line-height: 60px; transform: translateY(-50%); }
  .announcement-list__card { position: absolute; width: 317px; height: 308px; overflow: hidden; border: 2px solid rgba(90, 70, 130, .7); border-radius: 22px; background: rgba(22, 18, 36, .86); }
  .announcement-list__preview { position: absolute; top: 0; left: 0; width: 317px; height: 156px; border-radius: 22px; object-fit: cover; }
  .announcement-list__badge { position: absolute; top: 14px; left: 14px; width: 76px; height: 40px; border-radius: 12px; color: #eee8aa; background: #b22222; font-size: 24px; line-height: 40px; text-align: center; }
  .announcement-list__content { position: absolute; top: 172px; left: 18px; width: 281px; }
  .announcement-list__subject { display: -webkit-box; margin: 0; overflow: hidden; color: #f5f0e1; font-size: 22px; line-height: 30px; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .announcement-list__time { margin: 12px 0 0; color: #9691af; font-size: 18px; line-height: 22px; }
  .announcement-list__footer { position: absolute; left: 40px; width: 1000px; height: 96px; margin: 0; border: 2px solid rgba(90, 70, 130, .7); border-radius: 22px; color: #d2cddc; background: rgba(22, 18, 36, .86); font-size: 22px; line-height: 92px; padding-left: 28px; }
</style>
<header class="announcement-list__header"><h1>二重螺旋公告</h1></header>
<section class="announcement-list__grid">
  {% for card in cards %}
  <article class="announcement-list__card" style="left: {{ 40 + (loop.index0 % 3) * 341 }}px; top: {{ 200 + (loop.index0 // 3) * 332 }}px">
    {% if card.preview %}<img class="announcement-list__preview" src="{{ card.preview }}" alt="" />{% endif %}
    <span class="announcement-list__badge">#{{ card.index }}</span>
    <div class="announcement-list__content"><h2 class="announcement-list__subject">{{ card.subject }}</h2>{% if card.time %}<p class="announcement-list__time">{{ card.time }}</p>{% endif %}</div>
  </article>
  {% endfor %}
</section>
{% set rows = ((cards|length + 2) // 3) %}<footer class="announcement-list__footer" style="top: {{ 200 + rows * 308 + ((rows - 1) if rows else 0) * 24 + 36 }}px">发送 {{ prefix }}公告 + 序号 查看详情，例如：{{ prefix }}公告 1</footer>
{% endcall %}
