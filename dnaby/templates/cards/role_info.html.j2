{% from "cards/macros/layout.html.j2" import card_shell %}
{% from "cards/macros/components.html.j2" import legacy_profile_header %}
{% call card_shell(width, height, background=background, class_name="role-info") %}
<style>
  @font-face { font-family: "DNAFont"; src: url("{{ font }}") format("woff2"); }
  .role-info { position: relative; width: 1200px; height: {{ height }}px; color: #fff; font-family: "DNAFont", sans-serif; overflow: hidden; }
  .role-info__title { position: absolute; top: 0; left: 0; width: 1200px; height: 622px; object-fit: cover; -webkit-mask: url("{{ title_mask }}") center/1200px 622px no-repeat; mask: url("{{ title_mask }}") center/1200px 622px no-repeat; }
  .role-info .dna-legacy-profile { position: absolute; top: 400px; left: -50px; margin: 0; }
  .role-info__achievements { position: absolute; top: 650px; left: 100px; width: 1000px; height: 88px; margin: 0; padding: 0; background: url("{{ info_bar }}") center/1000px 88px no-repeat; text-align: center; }
  .role-info__achievements > div { position: absolute; top: 0; width: 130px; height: 88px; transform: translateX(-65px); }.role-info__achievements dt { height: 45px; margin: 0; font-size: 50px; font-weight: 400; line-height: 45px; }.role-info__achievements dd { height: 43px; margin: 0; color: #eee8aa; font-size: 25px; font-weight: 400; line-height: 43px; }
  .role-info__section { position: absolute; left: 0; width: 1200px; }.role-info__section-title { width: 1200px; height: 53px; margin: 0; background: url("{{ div_background }}") center/1200px 53px no-repeat; font-size: 40px; line-height: 53px; text-align: center; }
  .role-info__items { position: absolute; top: 70px; left: 50px; display: grid; grid-template-columns: repeat(5, 210px); grid-auto-rows: 300px; column-gap: 20px; row-gap: 20px; }.role-info__item { position: relative; width: 210px; height: 300px; overflow: hidden; background: center/210px 300px no-repeat; }.role-info__item.locked { opacity: .5; }.role-info__main-mask { position: absolute; inset: 0; width: 210px; height: 300px; -webkit-mask: url("{{ item_mask }}") 0 0/210px 300px no-repeat; mask: url("{{ item_mask }}") 0 0/210px 300px no-repeat; }.role-info__item img.main { position: absolute; top: 0; left: -20px; width: 256px; height: 256px; object-fit: fill; pointer-events: none; }.role-info__item img.fg { position: absolute; inset: 0; width: 210px; height: 300px; pointer-events: none; }.role-info__element { position: absolute; width: 42px; height: 42px; object-fit: contain; z-index: 2; }.role-info__element.role { top: 20px; left: 0; }.role-info__element.weapon { top: 23px; left: -3px; }.role-info__grade { position: absolute; top: 35px; left: 145px; width: 34px; height: 35px; border-radius: 7px; background: #b22222; z-index: 2; }.role-info__grade img { position: absolute; top: 5px; left: 0; width: 34px; height: 25px; }.role-info__name, .role-info__level { position: absolute; margin: 0; font-size: 20px; font-weight: 400; line-height: 25px; text-align: center; z-index: 2; }.role-info__name { top: 262px; left: 0; width: 200px; height: 26px; }.role-info__level { top: 202px; left: 78px; width: 100px; height: 26px; }
  .role-info__footer { position: absolute; bottom: 20px; left: 70px; width: 1060px; height: 40px; }
</style>
<img class="role-info__title" src="{{ title_background }}" alt="" />
{{ legacy_profile_header(header, header_background) }}
<dl class="role-info__achievements">{% for item in achievements %}<div style="left:{{ 65 + loop.index0 * 215 }}px"><dt>{{ item.value }}</dt><dd>{{ item.label }}</dd></div>{% endfor %}</dl>
{% set populated_sections = sections|selectattr("items")|list %}{% if not populated_sections %}<p style="position:absolute;top:780px;left:0;width:1200px;margin:0;font-size:30px;text-align:center">暂无已解锁条目</p>{% endif %}
{% set ns = namespace(top=750) %}{% for section in sections %}{% if section["items"] %}{% set rows = ((section["items"]|length - 1) // 5) + 1 %}<section class="role-info__section" style="top:{{ ns.top }}px;height:{{ 70 + rows * 320 }}px"><h2 class="role-info__section-title">{{ section.title }}</h2><div class="role-info__items">{% for item in section["items"] %}<article class="role-info__item{% if not item.unlocked %} locked{% endif %}" style="background-image:url('{{ section.background }}')">{% if item.image %}<div class="role-info__main-mask"><img class="main" src="{{ item.image }}" alt="" /></div>{% endif %}{% if item.element %}<img class="role-info__element {{ item.type }}" src="{{ item.element }}" alt="" />{% endif %}{% if item.grade %}<span class="role-info__grade"><img src="{{ item.grade }}" alt="" /></span>{% endif %}<p class="role-info__level">{% if item.level > 0 %}Lv.{{ item.level }}{% else %}未解锁{% endif %}</p><img class="fg" src="{{ item_foreground }}" alt="" /><p class="role-info__name">{{ item.name }}</p></article>{% endfor %}</div></section>{% set ns.top = ns.top + 70 + rows * 320 %}{% endif %}{% endfor %}
<img class="role-info__footer" src="{{ footer_image }}" alt="" />
{% endcall %}
