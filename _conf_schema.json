{
  "login": {
    "description": "登录",
    "type": "object",
    "items": {
      "url": {
        "type": "string",
        "description": "登录页或外置 dna-login 服务的 base URL；留空使用内置服务。",
        "default": ""
      },
      "bind_host": {
        "type": "string",
        "description": "内置登录服务监听地址。",
        "default": "127.0.0.1"
      },
      "port": {
        "type": "int",
        "description": "内置登录服务监听端口；0 表示由系统分配临时端口。",
        "default": 6189
      },
      "transport": {
        "type": "string",
        "description": "登录接入方式。",
        "default": "local",
        "options": [
          "local",
          "http_poll",
          "sse",
          "ws"
        ]
      },
      "shared_secret": {
        "type": "string",
        "description": "外置登录服务共享密钥；不会写入日志或用户响应。",
        "default": ""
      },
      "tencent_docs": {
        "type": "bool",
        "description": "是否启用腾讯文档登录辅助。",
        "default": false
      },
      "qr_login": {
        "type": "bool",
        "description": "是否将登录链接转换为二维码。",
        "default": false
      },
      "forward_login": {
        "type": "bool",
        "description": "是否将登录链接转换为转发消息。",
        "default": false
      },
      "max_bind_count": {
        "type": "int",
        "description": "未登录用户允许绑定的 UID 数量。",
        "default": 2
      }
    }
  },
  "network": {
    "description": "网络",
    "type": "object",
    "items": {
      "api_proxy_url": {
        "type": "string",
        "description": "二重螺旋 API 代理地址。",
        "default": ""
      },
      "local_proxy_url": {
        "type": "string",
        "description": "本地代理地址。",
        "default": ""
      },
      "proxy_functions": {
        "type": "list",
        "description": "需要使用代理的函数；空列表表示不额外指定。",
        "default": [],
        "options": [
          "all",
          "get_sms_code",
          "login"
        ]
      },
      "no_proxy_functions": {
        "type": "list",
        "description": "强制不使用代理的函数，优先级高于 proxy_functions。",
        "default": []
      },
      "websocket_continue_seconds": {
        "type": "int",
        "description": "WebSocket 保活持续时间（秒）。",
        "default": 300
      },
      "websocket_wait_seconds": {
        "type": "int",
        "description": "等待 WebSocket 建立连接的时间（秒）。",
        "default": 5
      }
    }
  },
  "sign_in": {
    "description": "签到",
    "type": "object",
    "items": {
      "community_tasks": {
        "type": "list",
        "description": "启用的社区任务。",
        "default": [
          "bbs_sign",
          "bbs_detail",
          "bbs_like",
          "bbs_share",
          "bbs_reply"
        ],
        "options": [
          "bbs_sign",
          "bbs_detail",
          "bbs_like",
          "bbs_share",
          "bbs_reply"
        ]
      },
      "enable_all_users": {
        "type": "bool",
        "description": "是否为所有已登录用户自动执行签到。",
        "default": false
      },
      "scheduled_enabled": {
        "type": "bool",
        "description": "是否启用定时签到。",
        "default": false
      },
      "sign_time": {
        "type": "string",
        "description": "每日签到时间，格式为 HH:mm。",
        "default": "00:05"
      },
      "concurrency": {
        "type": "int",
        "description": "自动签到并发数量。",
        "default": 1
      },
      "concurrency_interval_seconds": {
        "type": "list",
        "description": "自动签到任务之间的随机间隔范围（秒）。",
        "default": [
          3,
          5
        ]
      },
      "private_report": {
        "type": "bool",
        "description": "是否发送签到私聊报告。",
        "default": false
      },
      "group_report": {
        "type": "bool",
        "description": "是否发送签到群组报告。",
        "default": false
      },
      "group_report_image": {
        "type": "bool",
        "description": "是否以图片发送群组报告。",
        "default": false
      }
    }
  },
  "notifications": {
    "description": "通知",
    "type": "object",
    "items": {
      "announcement_enabled": {
        "type": "bool",
        "description": "是否启用公告推送。",
        "default": true
      },
      "announcement_groups": {
        "type": "object",
        "description": "公告推送群组配置。",
        "default": {},
        "items": {}
      },
      "announcement_ids": {
        "type": "list",
        "description": "已经推送过的公告 ID 列表。",
        "default": []
      },
      "announcement_check_minutes": {
        "type": "int",
        "description": "公告推送检查间隔（分钟）。",
        "default": 10
      },
      "secret_subscriptions": {
        "type": "list",
        "description": "密函订阅作用域。",
        "default": [
          "group"
        ],
        "options": [
          "private",
          "group"
        ]
      },
      "secret_push_time": {
        "type": "string",
        "description": "密函推送时间，格式为 分钟:秒。",
        "default": "00:30"
      },
      "secret_cache": {
        "type": "bool",
        "description": "是否缓存密函数据。",
        "default": true
      },
      "secret_simple_image": {
        "type": "bool",
        "description": "是否使用简单密函图片。",
        "default": false
      }
    }
  },
  "display": {
    "description": "显示",
    "type": "object",
    "items": {
      "command_prefix": {
        "type": "string",
        "description": "插件命令触发前缀，默认为 kk。",
        "default": "kk"
      },
      "guide_providers": {
        "type": "list",
        "description": "角色攻略图提供方。",
        "default": [
          "all"
        ],
        "options": [
          "all",
          "狩月庭攻略组",
          "猫冬"
        ]
      },
      "show_unowned_roles": {
        "type": "bool",
        "description": "是否在角色信息卡片中显示未拥有的角色和武器。",
        "default": true
      },
      "allow_mention_query": {
        "type": "bool",
        "description": "是否允许通过 @ 查询他人的角色信息。",
        "default": true
      }
    }
  }
}
