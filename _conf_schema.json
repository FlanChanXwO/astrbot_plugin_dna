{
  "login": {
    "description": "登录设置",
    "type": "object",
    "items": {
      "url": {
        "type": "string",
        "description": "登录服务地址",
        "hint": "登录页或外置 dna-login 服务的 base URL；留空使用内置服务",
        "default": ""
      },
      "bind_host": {
        "type": "string",
        "description": "内置服务监听地址",
        "hint": "内置登录服务监听地址",
        "default": "127.0.0.1"
      },
      "port": {
        "type": "int",
        "description": "内置服务监听端口",
        "hint": "内置登录服务监听端口；0 表示由系统分配临时端口",
        "default": 6189
      },
      "transport": {
        "type": "string",
        "description": "登录接入方式",
        "hint": "登录接入方式 (local/http_poll/sse/ws)",
        "default": "local",
        "options": [
          "local",
          "http_poll",
          "sse",
          "ws"
        ]
      },
      "shared_secret": {
        "type": "string",
        "description": "外置服务共享密钥",
        "hint": "外置登录服务共享密钥；不会写入日志或用户响应",
        "default": ""
      },
      "tencent_docs": {
        "type": "bool",
        "description": "腾讯文档登录辅助",
        "hint": "是否启用腾讯文档登录辅助",
        "default": false
      },
      "qr_login": {
        "type": "bool",
        "description": "二维码登录",
        "hint": "是否将登录链接转换为二维码",
        "default": false
      },
      "forward_login": {
        "type": "bool",
        "description": "转发消息登录",
        "hint": "是否将登录链接转换为转发消息",
        "default": false
      },
      "max_bind_count": {
        "type": "int",
        "description": "未登录用户最大绑定数",
        "hint": "未登录用户允许绑定的 UID 数量",
        "default": 2
      }
    }
  },
  "network": {
    "description": "网络设置",
    "type": "object",
    "items": {
      "api_proxy_url": {
        "type": "string",
        "description": "API 代理地址",
        "hint": "二重螺旋 API 代理地址",
        "default": ""
      },
      "local_proxy_url": {
        "type": "string",
        "description": "本地代理地址",
        "hint": "本地代理地址",
        "default": ""
      },
      "proxy_functions": {
        "type": "list",
        "description": "指定走代理的函数",
        "hint": "需要使用代理的函数；空列表表示不额外指定",
        "default": [],
        "options": [
          "all",
          "get_sms_code",
          "login"
        ]
      },
      "no_proxy_functions": {
        "type": "list",
        "description": "强制直连的函数",
        "hint": "强制不使用代理的函数，优先级高于 proxy_functions",
        "default": []
      },
      "websocket_continue_seconds": {
        "type": "int",
        "description": "WebSocket 保活时间",
        "hint": "WebSocket 保活持续时间（秒）",
        "default": 300
      },
      "websocket_wait_seconds": {
        "type": "int",
        "description": "WebSocket 连接等待时间",
        "hint": "等待 WebSocket 建立连接的时间（秒）",
        "default": 5
      }
    }
  },
  "sign_in": {
    "description": "签到设置",
    "type": "object",
    "items": {
      "community_tasks": {
        "type": "list",
        "description": "启用的社区任务",
        "hint": "启用的社区任务列表",
        "default": [
          "bbs_sign",
          "bbs_detail",
          "bbs_like",
          "bbs_share",
          "bbs_reply"
        ],
        "options": [
          "bbs_sign",
          "bbs_detail",
          "bbs_like",
          "bbs_share",
          "bbs_reply"
        ]
      },
      "enable_all_users": {
        "type": "bool",
        "description": "全员自动签到",
        "hint": "是否为所有已登录用户自动执行签到",
        "default": false
      },
      "scheduled_enabled": {
        "type": "bool",
        "description": "定时签到开关",
        "hint": "是否启用定时签到",
        "default": false
      },
      "sign_time": {
        "type": "string",
        "description": "每日签到时间",
        "hint": "每日签到时间，格式为 HH:mm（如 00:05）",
        "default": "00:05"
      },
      "concurrency": {
        "type": "int",
        "description": "签到并发数",
        "hint": "自动签到并发数量",
        "default": 1
      },
      "concurrency_interval_seconds": {
        "type": "list",
        "description": "签到任务随机间隔",
        "hint": "自动签到任务之间的随机间隔范围（秒）",
        "default": [
          3,
          5
        ]
      },
      "private_report": {
        "type": "bool",
        "description": "私聊签到报告",
        "hint": "是否发送签到私聊报告",
        "default": false
      },
      "group_report": {
        "type": "bool",
        "description": "群聊签到报告",
        "hint": "是否发送签到群组报告",
        "default": false
      },
      "group_report_image": {
        "type": "bool",
        "description": "图片形式群报告",
        "hint": "是否以图片发送群组报告",
        "default": false
      }
    }
  },
  "notifications": {
    "description": "通知设置",
    "type": "object",
    "items": {
      "announcement_enabled": {
        "type": "bool",
        "description": "公告推送开关",
        "hint": "是否启用公告推送",
        "default": true
      },
      "announcement_groups": {
        "type": "object",
        "description": "公告推送群组",
        "hint": "公告推送群组配置（群内输入 kk订阅公告 也会自动同步到此处）",
        "default": {},
        "items": {}
      },
      "announcement_ids": {
        "type": "list",
        "description": "已推送公告ID",
        "hint": "已经推送过的公告 ID 列表",
        "default": []
      },
      "announcement_check_minutes": {
        "type": "int",
        "description": "公告检查间隔",
        "hint": "公告推送检查间隔（分钟）",
        "default": 10
      },
      "secret_subscriptions": {
        "type": "list",
        "description": "密函订阅作用域",
        "hint": "密函订阅作用域 (private/group)",
        "default": [
          "group"
        ],
        "options": [
          "private",
          "group"
        ]
      },
      "secret_simple_image": {
        "type": "bool",
        "description": "简易密函图片",
        "hint": "是否使用简单密函图片",
        "default": false
      }
    }
  },
  "display": {
    "description": "显示设置",
    "type": "object",
    "items": {
      "command_prefixes": {
        "type": "list",
        "description": "命令触发前缀列表",
        "hint": "插件支持的命令触发前缀列表，如 ['kk', 'dna']；列表含空字符串时允许无前缀触发",
        "default": [
          "kk"
        ]
      },
      "guide_providers": {
        "type": "list",
        "description": "角色攻略提供方",
        "hint": "角色攻略图提供方",
        "default": [
          "all"
        ],
        "options": [
          "all",
          "狩月庭攻略组",
          "猫冬"
        ]
      },
      "show_unowned_roles": {
        "type": "bool",
        "description": "显示未拥有角色",
        "hint": "是否在角色信息卡片中显示未拥有的角色和武器",
        "default": true
      },
      "allow_mention_query": {
        "type": "bool",
        "description": "允许AT查询他人",
        "hint": "是否允许通过 @ 查询他人的角色信息",
        "default": true
      }
    }
  },
  "resources": {
    "description": "资源设置",
    "type": "object",
    "items": {
      "github_acceleration": {
        "type": "string",
        "description": "GitHub 资源加速模式",
        "hint": "默认直连；镜像失败会直接报告，不自动回退直连",
        "default": "off",
        "options": [
          "off",
          "edgeone",
          "hk",
          "gh_proxy",
          "dpik",
          "custom"
        ]
      },
      "custom_github_acceleration_url": {
        "type": "string",
        "description": "自定义 GitHub 加速前缀",
        "hint": "仅 custom 模式使用；填写不含 query、fragment 或凭据的 HTTP(S) 基础 URL",
        "default": ""
      }
    }
  },
  "cache": {
    "description": "缓存设置",
    "type": "object",
    "items": {
      "fresh_ttl_minutes": {
        "type": "int",
        "description": "缓存 fresh 保持时间（分钟）",
        "hint": "缓存内容在此时间内视为 fresh",
        "default": 30
      },
      "retention_ttl_hours": {
        "type": "int",
        "description": "缓存硬保留时间（小时）",
        "hint": "缓存超过此时间后允许清理",
        "default": 24
      },
      "announcement_ttl_hours": {
        "type": "int",
        "description": "公告缓存保留时间（小时）",
        "hint": "公告缓存的绝对保留时间",
        "default": 24
      },
      "refresh_send_card": {
        "type": "bool",
        "description": "刷新后发送卡片",
        "hint": "刷新成功后是否立即发送新卡片",
        "default": true
      }
    }
  }
}
